+	struct slim_stream_runtime *sruntime;
 };
 
-static void wcd9306_read_chip_id(struct slim_device *sdev)
+struct wcd9306_priv {
+	struct device *dev;
+	struct slim_device *slim;
+	struct slim_device *slim_ifc_dev;
+	struct regmap *regmap;
+	struct regmap *if_regmap;
+	struct snd_soc_component *component;
+	struct gpio_desc *reset_gpio;
+	struct clk *mclk;
+	u32 mclk_rate;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(wcd9306_static_supplies)];
+	bool supplies_on;
+	bool registered;
+	u8 version;
+	bool is_9302;		/* WCD9302: speaker on RX3 instead of RX4 */
+	u8 spk_int;		/* speaker interpolator index: 3 (RX4) or 2 (RX3) */
+
+	/* bandgap and clock block (wcd9xxx-resmgr), under clk_lock */
