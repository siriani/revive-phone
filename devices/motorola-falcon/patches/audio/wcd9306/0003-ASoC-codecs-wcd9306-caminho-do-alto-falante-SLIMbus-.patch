+#define WCD9306_SLIM_NUM_PORT_REG	3
+/* water mark 12 bytes, port enable */
+#define WCD9306_SLIM_WATER_MARK_VAL	((2 << 1) | 1)
+
+/* micbias: LDO_H 3.0 V (qcom,cdc-micbias-ldoh-v = 3) */
+#define WCD9306_LDOH_3P0_V		3
+#define WCD9306_LDOH_3P0_MAX_MV		2875
