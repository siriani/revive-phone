+/*
+ * WCD9306 or WCD9302 (tapan_check_wcd9306): sense the QFUSE with the RCO on;
+ * DATA_OUT1/2 are zero on the WCD9306.
+ */
+static bool wcd9306_is_9302(struct wcd9306_priv *wcd)
+{
+	struct regmap *rm = wcd->regmap;
+	unsigned int st = 0, d[8];
+	int i, tries;
+
+	mutex_lock(&wcd->clk_lock);
+	wcd9306_get_bandgap(wcd);
+	wcd9306_get_clk_block(wcd, WCD9306_CLK_RCO);
+
+	regmap_update_bits(rm, TAPAN_A_QFUSE_CTL, 0x03, 0x03);
+	for (tries = 0; tries < 100; tries++) {
+		regmap_read(rm, TAPAN_A_QFUSE_STATUS, &st);
+		if (st)
 			break;
+		usleep_range(1000, 1100);
+	}
+	for (i = 0; i < 8; i++)
+		regmap_read(rm, TAPAN_A_QFUSE_DATA_OUT0 + i, &d[i]);
+
+	wcd9306_put_clk_block(wcd, WCD9306_CLK_RCO);
+	wcd9306_put_bandgap(wcd);
+	mutex_unlock(&wcd->clk_lock);
+
+	dev_info(wcd->dev,
+		 "QFUSE status 0x%02x (%d ms): %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		 st, tries, d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+	if (!st)
+		dev_warn(wcd->dev, "QFUSE not sensed, assuming WCD9306\n");
+
+	return st && (d[1] || d[2]);
+}
+
+static int wcd9306_bring_up(struct wcd9306_priv *wcd)
+{
+	struct regmap *rm = wcd->regmap;
+	unsigned int id[4], ver;
+	u16 major;
+	int i, ret;
+
+	/* wcd9xxx_bring_up */
+	regmap_write(rm, TAPAN_A_LEAKAGE_CTL, 0x04);
+	regmap_write(rm, TAPAN_A_CDC_CTL, 0x00);
+	usleep_range(5000, 5100);
+	regmap_write(rm, TAPAN_A_CDC_CTL, 0x03);
+	regmap_write(rm, TAPAN_A_LEAKAGE_CTL, 0x03);
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_read(rm, TAPAN_A_CHIP_ID_BYTE_0 + i, &id[i]);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_read(rm, TAPAN_A_CHIP_VERSION, &ver);
+	if (ret)
+		return ret;
+
+	major = id[2] | (id[3] << 8);
+	wcd->version = ver & 0x1f;
+	dev_info(wcd->dev, "WCD9306 chip id major 0x%04x minor 0x%04x, version %u\n",
+		 major, id[0] | (id[1] << 8), wcd->version);
+	if (major != WCD9306_CHIP_MAJOR) {
+		dev_err(wcd->dev, "not a tapan codec (major 0x%04x)\n", major);
+		return -ENODEV;
+	}
+
+	wcd->is_9302 = wcd9306_is_9302(wcd);
+	wcd->spk_int = wcd->is_9302 ? 2 : 3;
+	dev_info(wcd->dev, "variant %s, speaker on RX%u\n",
+		 wcd->is_9302 ? "WCD9302" : "WCD9306", wcd->spk_int + 1);
+	return 0;
+}
+
+static void wcd9306_regmap_exit(void *data)
+{
+	regmap_exit(data);
+}
+
+/*
+ * regmap_init_slimbus() and not the devm_ variant: __devm_regmap_init_slimbus()
+ * of 6.16 passes &slimbus (address of its own argument) as the bus context.
+ */
+static struct regmap *wcd9306_regmap_init(struct device *owner,
+					  struct slim_device *sdev,
+					  const struct regmap_config *cfg)
+{
+	struct regmap *rm;
+	int ret;
+
+	rm = regmap_init_slimbus(sdev, cfg);
+	if (IS_ERR(rm))
+		return rm;
+	ret = devm_add_action_or_reset(owner, wcd9306_regmap_exit, rm);
+	if (ret)
+		return ERR_PTR(ret);
+	return rm;
+}
+
+/* pgd: register access device, ifd: SLIMbus port device, dev: bound device */
+static int wcd9306_init(struct wcd9306_priv *wcd, struct slim_device *pgd,
+			struct slim_device *ifd, struct device *dev)
+{
+	int ret;
+
+	ret = wcd9306_get_laddr(ifd);
+	if (ret) {
+		dev_err(dev, "interface device without logical address: %d\n",
+			ret);
+		return ret;
+	}
+	dev_info(dev, "PGD %s LA 0x%x, IFD %s LA 0x%x\n",
+		 dev_name(&pgd->dev), pgd->laddr,
+		 dev_name(&ifd->dev), ifd->laddr);
+
+	wcd->slim = pgd;
+	wcd->slim_ifc_dev = ifd;
+
+	if (!wcd->regmap) {
+		wcd->regmap = wcd9306_regmap_init(dev, pgd,
+						  &wcd9306_regmap_config);
+		if (IS_ERR(wcd->regmap)) {
+			ret = PTR_ERR(wcd->regmap);
+			wcd->regmap = NULL;
+			return dev_err_probe(dev, ret, "regmap\n");
+		}
+	}
+	if (!wcd->if_regmap) {
+		wcd->if_regmap = wcd9306_regmap_init(dev, ifd,
+						     &wcd9306_ifc_regmap_config);
+		if (IS_ERR(wcd->if_regmap)) {
+			ret = PTR_ERR(wcd->if_regmap);
+			wcd->if_regmap = NULL;
+			return dev_err_probe(dev, ret, "ifd regmap\n");
+		}
+	}
+
+	ret = wcd9306_bring_up(wcd);
+	if (ret)
+		return ret;
+
+	ret = devm_snd_soc_register_component(dev, &wcd9306_component_drv,
+					      wcd9306_slim_dais,
+					      ARRAY_SIZE(wcd9306_slim_dais));
+	if (ret)
+		return dev_err_probe(dev, ret, "register component\n");
+
+	wcd->registered = true;
+	return 0;
+}
+
+/* elemental address of the other function of the codec (PGD <-> IFD) */
+static struct slim_device *wcd9306_sibling(struct slim_device *sdev,
+					   u8 dev_index)
+{
+	struct slim_eaddr ea = {
+		.manf_id = sdev->e_addr.manf_id,
+		.prod_code = sdev->e_addr.prod_code,
+		.dev_index = dev_index,
+		.instance = sdev->e_addr.instance,
+	};
+
+	return slim_get_device(sdev->ctrl, &ea);
+}
+
+static int wcd9306_slim_status(struct slim_device *sdev,
+			       enum slim_device_status status)
+{
+	struct device *dev = &sdev->dev;
+	struct wcd9306_priv *wcd = dev_get_drvdata(dev);
+	struct device_node *np;
+	struct slim_device *ifd;
+
+	dev_info(dev, "SLIMbus %s, LA 0x%x\n",
+		 status == SLIM_DEVICE_STATUS_UP ? "UP" : "DOWN", sdev->laddr);
+	if (status != SLIM_DEVICE_STATUS_UP || wcd->registered)
+		return 0;
+
+	/* "slim-ifc-dev" like wcd9335, else the EA 00 00 e0 00 17 02 */
+	np = of_parse_phandle(dev->of_node, "slim-ifc-dev", 0);
+	if (np) {
+		ifd = of_slim_get_device(sdev->ctrl, np);
+		of_node_put(np);
+	} else {
+		ifd = wcd9306_sibling(sdev, 0);
+	}
+	if (IS_ERR_OR_NULL(ifd)) {
+		dev_err(dev, "no SLIMbus interface device\n");
+		return -EINVAL;
+	}
+	return wcd9306_init(wcd, sdev, ifd, dev);
+}
+
+static void wcd9306_supplies_off(void *data)
+{
+	struct wcd9306_priv *wcd = data;
+
+	regulator_bulk_disable(ARRAY_SIZE(wcd->supplies), wcd->supplies);
+}
+
+/* driver data, clock, supplies and reset line of the bound device */
+static struct wcd9306_priv *wcd9306_setup(struct device *dev)
+{
+	struct wcd9306_priv *wcd;
+	int i, ret;
+
+	wcd = devm_kzalloc(dev, sizeof(*wcd), GFP_KERNEL);
+	if (!wcd)
+		return ERR_PTR(-ENOMEM);
+
+	wcd->dev = dev;
+	mutex_init(&wcd->clk_lock);
+	wcd->mclk_rate = WCD9306_MCLK_9P6MHZ;
+	for (i = 0; i < WCD9306_RX_MAX; i++) {
+		wcd->rx_chs[i].port = WCD9306_RX_PORT_START + i;
+		wcd->rx_chs[i].shift = i;
+		INIT_LIST_HEAD(&wcd->rx_chs[i].list);
+	}
+
+	wcd->mclk = devm_clk_get_optional(dev, "mclk");
+	if (IS_ERR(wcd->mclk))
+		return ERR_PTR(dev_err_probe(dev, PTR_ERR(wcd->mclk), "mclk\n"));
+	if (!wcd->mclk)
+		dev_warn(dev, "no mclk in DT, %s\n",
+			 allow_rco ? "audio clock from the internal RCO (test)" :
+				     "no audio clock");
+	else
+		clk_set_rate(wcd->mclk, wcd->mclk_rate);
+
+	for (i = 0; i < ARRAY_SIZE(wcd9306_static_supplies); i++)
+		wcd->supplies[i].supply = wcd9306_static_supplies[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(wcd->supplies),
+				      wcd->supplies);
+	if (ret)
+		return ERR_PTR(dev_err_probe(dev, ret, "supplies\n"));
+	ret = regulator_bulk_enable(ARRAY_SIZE(wcd->supplies), wcd->supplies);
+	if (ret)
+		return ERR_PTR(dev_err_probe(dev, ret, "enable supplies\n"));
+	ret = devm_add_action_or_reset(dev, wcd9306_supplies_off, wcd);
+	if (ret)
+		return ERR_PTR(ret);
+
+	wcd->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(wcd->reset_gpio))
+		return ERR_PTR(dev_err_probe(dev, PTR_ERR(wcd->reset_gpio),
+					     "reset\n"));
+
+	dev_set_drvdata(dev, wcd);
+	return wcd;
+}
+
+static int wcd9306_slim_probe(struct slim_device *sdev)
+{
+	struct device *dev = &sdev->dev;
+	struct wcd9306_priv *wcd;
+	int ret;
+
+	wcd = wcd9306_setup(dev);
+	if (IS_ERR(wcd))
+		return PTR_ERR(wcd);
+
+	/*
+	 * Driver rebound to a codec that is already enumerated: the SLIMbus
+	 * core only calls device_status() on a status change, and a reset now
+	 * would invalidate the logical address it keeps. Use it as it is.
+	 */
+	if (sdev->is_laddr_valid && sdev->status == SLIM_DEVICE_STATUS_UP) {
+		dev_info(dev, "codec already enumerated (LA 0x%x), no reset\n",
+			 sdev->laddr);
+		return wcd9306_slim_status(sdev, SLIM_DEVICE_STATUS_UP);
+	}
+
+	if (wcd->reset_gpio) {
+		/* active low: 1 = in reset */
+		gpiod_direction_output(wcd->reset_gpio, 1);
 		msleep(20);
+		gpiod_set_value_cansleep(wcd->reset_gpio, 0);
+		msleep(20);
+		dev_info(dev, "codec reset\n");
 	}
+
+	/* the codec reports present after the reset: retry the address */
+	ret = wcd9306_get_laddr(sdev);
 	if (ret)
-		dev_err(dev, "sem endereco logico apos %d tentativas: %d\n",
-			WCD9306_LADDR_TRIES, ret);
+		dev_warn(dev, "no logical address yet: %d\n", ret);
 
-	return devm_snd_soc_register_component(dev, &wcd9306_component_drv,
-					       NULL, 0);
+	return 0;
 }
 
 static const struct slim_device_id wcd9306_slim_id[] = {
-	{0x0217, 0x00e0, 0x1, 0x0},
-	{}
+	{ 0x0217, 0x00e0, 0x1, 0x0 },
+	{ }
 };
 MODULE_DEVICE_TABLE(slim, wcd9306_slim_id);
 
