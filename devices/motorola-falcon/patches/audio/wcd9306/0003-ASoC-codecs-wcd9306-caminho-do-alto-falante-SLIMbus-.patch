+static int slim_rx_mux_get(struct snd_kcontrol *kc,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct wcd9306_priv *wcd = dev_get_drvdata(w->dapm->dev);
+
+	ucontrol->value.enumerated.item[0] = wcd->rx_port_value[w->shift];
+	return 0;
+}
+
+static int slim_rx_mux_put(struct snd_kcontrol *kc,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct wcd9306_priv *wcd = dev_get_drvdata(w->dapm->dev);
+	struct soc_enum *e = (struct soc_enum *)kc->private_value;
+	u32 port_id = w->shift;
+	u32 val = ucontrol->value.enumerated.item[0];
+
+	if (val >= ARRAY_SIZE(slim_rx_mux_text))
+		return -EINVAL;
+	if (wcd->rx_port_value[port_id] == val)
+		return 0;
+
+	wcd->rx_port_value[port_id] = val;
+	list_del_init(&wcd->rx_chs[port_id].list);
+	if (val == 1)
+		list_add_tail(&wcd->rx_chs[port_id].list,
+			      &wcd->dai[AIF1_PB].slim_ch_list);
+
+	snd_soc_dapm_mux_update_power(w->dapm, kc, val, e, NULL);
+	return 1;
+}
