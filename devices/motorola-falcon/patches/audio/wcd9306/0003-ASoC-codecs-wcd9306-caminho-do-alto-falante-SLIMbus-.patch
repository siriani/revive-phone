+static int wcd9306_set_interpolator_rate(struct snd_soc_dai *dai, u8 val)
+{
+	struct snd_soc_component *comp = dai->component;
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+	struct wcd9306_slim_ch *ch;
+	unsigned int b1, b2;
+	u8 inp;
+
+	/* only the speaker interpolator: set its rate if it takes a SLIM RX */
+	if (wcd->is_9302) {
+		b1 = snd_soc_component_read(comp, TAPAN_A_CDC_CONN_RX3_B1_CTL);
+		b2 = 0;
+	} else {
+		b1 = snd_soc_component_read(comp, TAPAN_A_CDC_CONN_RX4_B1_CTL);
+		b2 = snd_soc_component_read(comp, TAPAN_A_CDC_CONN_RX4_B2_CTL);
+	}
+	list_for_each_entry(ch, &wcd->dai[dai->id].slim_ch_list, list) {
+		/* RX_MIX1 input value: RX1 = 5 .. RX5 = 9 */
+		inp = ch->port - WCD9306_RX_PORT_START + 5;
+		if ((b1 & 0x0f) == inp || ((b1 >> 4) & 0x0f) == inp ||
+		    (b2 & 0x0f) == inp)
+			snd_soc_component_update_bits(comp,
+				TAPAN_A_CDC_RX1_B5_CTL + 8 * wcd->spk_int,
+				0xe0, val);
+	}
+	return 0;
+}
+
+static int wcd9306_slim_set_hw_params(struct wcd9306_priv *wcd,
+				      struct wcd9306_dai_data *dai_data)
+{
+	struct slim_stream_config *cfg = &dai_data->sconfig;
+	struct wcd9306_slim_ch *ch;
+	u16 payload = 0;
+	int ret, i;
+
+	cfg->ch_count = 0;
+	cfg->direction = SNDRV_PCM_STREAM_PLAYBACK;
+	cfg->port_mask = 0;
+
+	list_for_each_entry(ch, &dai_data->slim_ch_list, list) {
+		cfg->ch_count++;
+		payload |= 1 << ch->shift;
+		cfg->port_mask |= BIT(ch->port);
+	}
+
+	kfree(cfg->chs);
+	cfg->chs = kcalloc(cfg->ch_count, sizeof(unsigned int), GFP_KERNEL);
+	if (!cfg->chs)
+		return -ENOMEM;
+
+	i = 0;
+	list_for_each_entry(ch, &dai_data->slim_ch_list, list) {
+		cfg->chs[i++] = ch->ch_num;
+		ret = regmap_write(wcd->if_regmap,
+				   WCD9306_SLIM_RX_MULTI_CHAN(ch->port),
+				   payload);
+		if (ret < 0)
+			goto err;
+		/* water mark and port enable */
+		ret = regmap_write(wcd->if_regmap,
+				   WCD9306_SLIM_RX_PORT_CFG(ch->port),
+				   WCD9306_SLIM_WATER_MARK_VAL);
+		if (ret < 0)
+			goto err;
+	}
+
+	if (!dai_data->sruntime)
+		dai_data->sruntime = slim_stream_allocate(wcd->slim,
+							  "WCD9306-SLIM");
+	return 0;
+
+err:
+	dev_err(wcd->dev, "SLIMbus port setup failed: %d\n", ret);
+	kfree(cfg->chs);
+	cfg->chs = NULL;
+	return ret;
+}
+
+static int wcd9306_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *comp = dai->component;
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+	u8 rx_fs;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return -EINVAL;
+	if (wcd->is_9302 && params_rate(params) > 48000)
+		return -EINVAL;
+
+	switch (params_rate(params)) {
+	case 8000:
+		rx_fs = 0x00;
+		break;
+	case 16000:
+		rx_fs = 0x20;
+		break;
+	case 32000:
+		rx_fs = 0x40;
+		break;
+	case 48000:
+		rx_fs = 0x60;
+		break;
+	case 96000:
+		rx_fs = 0x80;
+		break;
+	case 192000:
+		rx_fs = 0xa0;
+		break;
+	default:
+		dev_err(wcd->dev, "rate %d not supported\n",
+			params_rate(params));
+		return -EINVAL;
+	}
+	wcd9306_set_interpolator_rate(dai, rx_fs);
+
+	switch (params_width(params)) {
+	case 16:
+		snd_soc_component_write(comp, TAPAN_A_CDC_CONN_RX_SB_B1_CTL, 0xaa);
+		snd_soc_component_write(comp, TAPAN_A_CDC_CONN_RX_SB_B2_CTL, 0x2a);
+		break;
+	case 24:
+		snd_soc_component_write(comp, TAPAN_A_CDC_CONN_RX_SB_B1_CTL, 0x00);
+		snd_soc_component_write(comp, TAPAN_A_CDC_CONN_RX_SB_B2_CTL, 0x00);
+		break;
+	default:
+		dev_err(wcd->dev, "width %d not supported\n",
+			params_width(params));
+		return -EINVAL;
+	}
+
+	wcd->dai[dai->id].sconfig.rate = params_rate(params);
+	wcd->dai[dai->id].sconfig.bps = params_width(params);
+
+	return wcd9306_slim_set_hw_params(wcd, &wcd->dai[dai->id]);
+}
+
+static int wcd9306_trigger(struct snd_pcm_substream *substream, int cmd,
+			   struct snd_soc_dai *dai)
+{
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(dai->component);
+	struct wcd9306_dai_data *dai_data = &wcd->dai[dai->id];
+
+	if (!dai_data->sruntime)
+		return -EINVAL;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		slim_stream_prepare(dai_data->sruntime, &dai_data->sconfig);
+		slim_stream_enable(dai_data->sruntime);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		slim_stream_disable(dai_data->sruntime);
+		slim_stream_unprepare(dai_data->sruntime);
+		break;
 	}
+	return 0;
+}
+
+static int wcd9306_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct snd_soc_component *comp = dai->component;
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
 
 	/*
-	 * O ADSP so responde ao ADDR_QUERY depois do REPORT_PRESENT do codec;
-	 * como o downstream (LADDR_RETRY), tenta algumas vezes. Ao conseguir,
-	 * o nucleo chama wcd9306_slim_status(UP), que le o chip id.
+	 * mute of the speaker interpolator: RXn_B6_CTL bit 0, as in the
+	 * same digital core of msm8916-wcd-digital (RXn_B6_CTL_MUTE_MASK)
 	 */
+	snd_soc_component_update_bits(comp,
+				      TAPAN_A_CDC_RX1_B6_CTL + 8 * wcd->spk_int,
+				      0x01, mute ? 0x01 : 0x00);
+	return 0;
+}
+
+/*
+ * The machine driver gives the SLIMbus channel numbers of the DSP side
+ * (e.g. 144.. for the q6 SLIMBUS_0_RX port) in rx_slot[]; rx_slot[i] goes
+ * with codec RX port i (SLIM RX(i+1), slave port 16 + i). tx_slot is not
+ * used (no capture DAI yet).
+ */
+static int wcd9306_set_channel_map(struct snd_soc_dai *dai,
+				   unsigned int tx_num,
+				   const unsigned int *tx_slot,
+				   unsigned int rx_num,
+				   const unsigned int *rx_slot)
+{
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(dai->component);
+	unsigned int i;
+
+	if (!rx_slot) {
+		dev_err(wcd->dev, "no rx_slot\n");
+		return -EINVAL;
+	}
+
+	/* the card may pass a longer list (13 RX like apq8096): keep ours */
+	rx_num = min_t(unsigned int, rx_num, WCD9306_RX_MAX);
+	wcd->num_rx_port = rx_num;
+	for (i = 0; i < rx_num; i++)
+		wcd->rx_chs[i].ch_num = rx_slot[i];
+
+	return 0;
+}
+
+static int wcd9306_get_channel_map(const struct snd_soc_dai *dai,
+				   unsigned int *tx_num, unsigned int *tx_slot,
+				   unsigned int *rx_num, unsigned int *rx_slot)
+{
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(dai->component);
+	struct wcd9306_slim_ch *ch;
+	int i = 0;
+
+	if (dai->id != AIF1_PB || !rx_slot || !rx_num)
+		return -EINVAL;
+
+	list_for_each_entry(ch, &wcd->dai[dai->id].slim_ch_list, list)
+		rx_slot[i++] = ch->ch_num;
+	*rx_num = i;
+
+	return 0;
+}
