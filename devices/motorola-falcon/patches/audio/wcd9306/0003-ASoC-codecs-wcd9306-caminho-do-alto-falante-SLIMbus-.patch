+static int wcd9306_codec_enable_interpolator(struct snd_soc_dapm_widget *w,
+					     struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	unsigned int gain_reg = TAPAN_A_CDC_RX1_VOL_CTL_B2_CTL + 8 * w->shift;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_CLK_RX_RESET_CTL,
+					      1 << w->shift, 1 << w->shift);
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_CLK_RX_RESET_CTL,
+					      1 << w->shift, 0);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		/* apply the digital gain after the interpolator is enabled */
+		snd_soc_component_write(comp, gain_reg,
+					snd_soc_component_read(comp, gain_reg));
+		break;
+	}
+	return 0;
+}
+
+static int wcd9306_codec_enable_spk_pa(struct snd_soc_dapm_widget *w,
+				       struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_SPKR_DRV_EN,
+					      0x80, 0x80);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		snd_soc_component_update_bits(comp, TAPAN_A_SPKR_DRV_EN,
+					      0x80, 0x00);
+		break;
+	}
+	return 0;
+}
+
+static int wcd9306_codec_enable_vdd_spkr(struct snd_soc_dapm_widget *w,
+					 struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+
+	/* tapan 1.0 only: leakage on the speaker driver power stage */
+	if (wcd->version != 0)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_SPKR_DRV_DBG_PWRSTG,
+					      0x24, 0x00);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		snd_soc_component_update_bits(comp, TAPAN_A_SPKR_DRV_DBG_PWRSTG,
+					      0x24, 0x24);
+		break;
+	}
+	return 0;
+}
+
+static int wcd9306_codec_enable_ldo_h(struct snd_soc_dapm_widget *w,
+				      struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (++wcd->ldo_h_users == 1) {
+			mutex_lock(&wcd->clk_lock);
+			wcd9306_get_bandgap(wcd);
+			wcd9306_get_clk_block(wcd, WCD9306_CLK_RCO);
+			snd_soc_component_update_bits(comp, TAPAN_A_LDO_H_MODE_1,
+						      0x80, 0x80);
+			wcd9306_put_clk_block(wcd, WCD9306_CLK_RCO);
+			mutex_unlock(&wcd->clk_lock);
+			/* LDO needs 1 ms to settle */
+			usleep_range(1000, 1100);
+		}
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		if (--wcd->ldo_h_users == 0) {
+			mutex_lock(&wcd->clk_lock);
+			wcd9306_get_clk_block(wcd, WCD9306_CLK_RCO);
+			snd_soc_component_update_bits(comp, TAPAN_A_LDO_H_MODE_1,
+						      0x80, 0x00);
+			wcd9306_put_clk_block(wcd, WCD9306_CLK_RCO);
+			wcd9306_put_bandgap(wcd);
+			mutex_unlock(&wcd->clk_lock);
+		}
+		break;
+	}
+	return 0;
+}
+
+/* MIC BIAS1 External: cfilt1, external bypass capacitor */
+static int wcd9306_codec_enable_micbias1(struct snd_soc_dapm_widget *w,
+					 struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (wcd->cfilt1_users++ == 0)
+			snd_soc_component_update_bits(comp,
+						      TAPAN_A_MICB_CFILT_1_CTL,
+						      0x80, 0x80);
+		snd_soc_component_update_bits(comp, TAPAN_A_MICB_1_CTL,
+					      0x80, 0x80);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		usleep_range(20000, 20100);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		snd_soc_component_update_bits(comp, TAPAN_A_MICB_1_CTL,
+					      0x80, 0x00);
+		if (--wcd->cfilt1_users == 0)
+			snd_soc_component_update_bits(comp,
+						      TAPAN_A_MICB_CFILT_1_CTL,
+						      0x80, 0x00);
+		break;
+	}
+	return 0;
+}
+
+static int wcd9306_codec_enable_adc1(struct snd_soc_dapm_widget *w,
+				     struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+
+	/* ADC1 init bit is TX_1_2_TEST_CTL[7] */
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_TX_1_2_TEST_CTL,
+					      0x80, 0x80);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_TX_1_2_TEST_CTL,
+					      0x80, 0x00);
+		break;
+	}
+	return 0;
+}
+
+static int wcd9306_codec_enable_dec1(struct snd_soc_dapm_widget *w,
+				     struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		/* TX digital mute while the decimator starts */
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_VOL_CTL_CFG,
+					      0x01, 0x01);
+		snd_soc_component_update_bits(comp,
+					      TAPAN_A_CDC_CLK_TX_RESET_B1_CTL,
+					      0x01, 0x01);
+		snd_soc_component_update_bits(comp,
+					      TAPAN_A_CDC_CLK_TX_RESET_B1_CTL,
+					      0x01, 0x00);
+		/* HPF at 150 Hz, enabled */
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_MUX_CTL,
+					      0x30, 0x20);
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_MUX_CTL,
+					      0x08, 0x00);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_VOL_CTL_CFG,
+					      0x01, 0x00);
+		snd_soc_component_write(comp, TAPAN_A_CDC_TX1_VOL_CTL_GAIN,
+			snd_soc_component_read(comp,
+					       TAPAN_A_CDC_TX1_VOL_CTL_GAIN));
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_VOL_CTL_CFG,
+					      0x01, 0x01);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		snd_soc_component_update_bits(comp, TAPAN_A_CDC_TX1_MUX_CTL,
+					      0x08, 0x08);
+		break;
+	}
+	return 0;
+}
+
+/* AIF1 PB: SLIMbus RX ports on the interface device */
+static int wcd9306_codec_enable_slim(struct snd_soc_dapm_widget *w,
+				     struct snd_kcontrol *kc, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct wcd9306_priv *wcd = snd_soc_component_get_drvdata(comp);
+	struct wcd9306_dai_data *dai = &wcd->dai[w->shift];
+	struct wcd9306_slim_ch *ch;
+
+	if (event != SND_SOC_DAPM_POST_PMD)
+		return 0;
+
+	/* port disable; slim_stream_disable already took the channels down */
+	list_for_each_entry(ch, &dai->slim_ch_list, list)
+		regmap_write(wcd->if_regmap,
+			     WCD9306_SLIM_RX_PORT_CFG(ch->port), 0x00);
+	return 0;
+}
