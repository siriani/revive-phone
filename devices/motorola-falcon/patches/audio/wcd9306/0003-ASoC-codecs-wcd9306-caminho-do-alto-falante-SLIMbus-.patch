+static int wcd9306_get_laddr(struct slim_device *sdev)
+{
+	int i, ret = -ENXIO;
+
 	for (i = 0; i < WCD9306_LADDR_TRIES; i++) {
 		ret = slim_get_logical_addr(sdev);
 		if (!ret)
+			return 0;
+		msleep(20);
+	}
+	return ret;
+}
