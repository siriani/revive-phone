From 879f1e66a16e430c7557b9db192eaef1503dca4e Mon Sep 17 00:00:00 2001
From: Allan Siriani <allan@fatecpompeia.edu.br>
Date: Wed, 4 Nov 2026 16:12:23 -0300
Subject: [PATCH 3/3] ASoC: codecs: wcd9306: caminho do alto-falante (SLIMbus
 RX -> classe D)

Troca o esqueleto (so chip id) por um driver de verdade para o codec
tapan do MSM8226, portado do driver msm-3.4 (wcd9306.c, wcd9xxx-resmgr.c,
wcd9xxx-core.c, wcd9xxx-slimslave.c; GPL-2.0, copyright da Linux
Foundation mantido) com a estrutura do wcd9335 mainline:

- PGD (registradores, base 0x800) e IFD (portas SLIMbus) com regmap;
  o IFD e achado pelo endereco de enumeracao (dev_index 0);
- reset, alimentacoes estaticas (vdd-h, vdd-px, vdd-cx) e o bring-up do
  wcd9xxx-core; defaults e reg_init do tapan (2.x e 1.0);
- deteccao WCD9306/WCD9302 pelo QFUSE (tapan_check_wcd9306): no 9302 o
  alto-falante usa o RX3, no 9306 o RX4;
- clock: MCLK do DT (9,6 MHz) ou, sem MCLK, o oscilador RC interno
  (allow_rco, so para teste), com as sequencias de bandgap e clock block;
- DAI de reproducao wcd9306_rx1 (AIF1 PB, SLIM RX1..RX5) com
  set_channel_map/get_channel_map, hw_params e trigger com slim_stream;
- DAPM: SLIM RXn -> interpolador -> SPK DAC -> SPK PA -> SPK_OUT, com
  RXn Digital Volume, SPK DRV Volume, SPK DAC Switch e mute do
  interpolador (RXn_B6 bit 0, como no msm8916-wcd-digital);
- sidetone AMIC1 -> ADC1 -> DEC1 -> IIR1 -> interpolador, com micbias 1
  (cfilt1, LDO_H 3,0 V) e o DEC1 com HPF.

Sem fone, earpiece, lineout, classe H, compander, ANC, MBHC, TX nem
interrupcoes do codec.
---
 sound/soc/codecs/Kconfig          |    9 +-
 sound/soc/codecs/Makefile         |    2 +-
 sound/soc/codecs/wcd9306-tables.c |  496 ++++++++
 sound/soc/codecs/wcd9306.c        | 1739 +++++++++++++++++++++++++++--
 sound/soc/codecs/wcd9306.h        |  520 +++++++++
 5 files changed, 2681 insertions(+), 85 deletions(-)
 create mode 100644 sound/soc/codecs/wcd9306-tables.c
 create mode 100644 sound/soc/codecs/wcd9306.h

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 8a1091861..c2fdc984a 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2228,11 +2228,14 @@ config SND_SOC_WCD_CLASSH
 	tristate
 
 config SND_SOC_WCD9306
-	tristate "WCD9306 Codec (esqueleto, so chip id)"
+	tristate "WCD9306/WCD9302 (tapan) Codec"
 	depends on SLIMBUS
+	select REGMAP_SLIMBUS
 	help
-	  Esqueleto do codec WCD9306 (tapan) do MSM8226, ligado por SLIMbus.
-	  Por enquanto so enumera e le o chip id para o log. Sem audio.
+	  Qualcomm WCD9306 and WCD9302 (tapan) audio codecs on SLIMbus, used
+	  with the MSM8226 (e.g. Motorola Moto G 2013). Supports the speaker
+	  playback path (SLIMbus RX to the class-D speaker driver) and the
+	  sidetone path.
 
 config SND_SOC_WCD9335
 	tristate "WCD9335 Codec"
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index b14e07a58..cd820f6bd 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -340,7 +340,7 @@ snd-soc-uda1380-y := uda1380.o
