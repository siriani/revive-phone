-// SPDX-License-Identifier: GPL-2.0
+// SPDX-License-Identifier: GPL-2.0-only
 /*
- * WCD9306 (tapan) audio codec over SLIMbus: esqueleto.
+ * Qualcomm WCD9306 (tapan) audio codec, SLIMbus interface.
  *
- * Por enquanto so enumera pelo barramento SLIMbus (manf 0x217, prod 0xe0,
- * EA downstream 00 01 e0 00 17 02) e le o chip id para o dmesg.
- * Sem caminho de audio, sem MBHC, sem supplies.
+ * Copyright (c) 2012-2014, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2026, Allan Siriani <allan@fatecpompeia.edu.br>
  *
- * Registradores (downstream LineageOS msm8226, wcd9306_registers.h):
- *   TAPAN_A_CHIP_ID_BYTE_0..3 = 0x004..0x007.
- * No MFD downstream (wcd9xxx-core.c) o minor vem de BYTE_0..1 e o major de
- * BYTE_2..3, little endian. TAPAN_MAJOR = 0x0103 (core.h), ou seja
- * BYTE_2 = 0x03 e BYTE_3 = 0x01 (o POR de BYTE_3 e 0x01).
- * O downstream separa WCD9306 de WCD9302 por QFUSE, nao pelo chip id; aqui
- * so logamos o valor, sem decidir a variante.
+ * Port of the speaker playback path of the msm-3.4 tapan driver
+ * (sound/soc/codecs/wcd9306.c, wcd9xxx-resmgr.c, drivers/mfd/wcd9xxx-core.c
+ * and wcd9xxx-slimslave.c) to the mainline SLIMbus/regmap/ASoC APIs, with
+ * the structure of the mainline wcd9335 driver.
  *
- * Acesso pelo SLIMbus: o downstream soma WCD9XXX_REGISTER_START_OFFSET
- * (0x800) ao endereco do registrador (wcd9xxx_slim_read_device), igual ao
- * "reg base 0x800" do wcd9335 mainline. Entao BYTE_0..3 = 0x804..0x807 no
- * barramento.
+ * What is here:
+ *  - SLIMbus PGD (register access) and IFD (port configuration) devices;
+ *  - reset, static supplies (vdd-h, vdd-px, vdd-cx) and the codec bring-up;
+ *  - register defaults of the downstream driver;
+ *  - codec clock: external MCLK (9.6 MHz) or, without MCLK, the internal RC
+ *    oscillator (RCO), with the bandgap/clock-block sequences of wcd9xxx-resmgr;
+ *  - playback DAI "wcd9306_rx1" (AIF1 PB, SLIM RX1..RX5) with
+ *    set_channel_map/get_channel_map in the wcd9335 style;
+ *  - WCD9306/WCD9302 detection by QFUSE (tapan_check_wcd9306);
+ *  - SLIM RXn -> speaker interpolator (RX4 on the WCD9306, RX3 on the
+ *    WCD9302) -> class-D speaker driver (SPK_OUT);
+ *  - sidetone path AMIC1 -> ADC1 -> DEC1 -> IIR1 -> speaker interpolator (used
+ *    in calls), which also gives a source inside the codec to test the
+ *    speaker without the DSP.
  *
- * Sequencia (wcd9xxx_slim_probe downstream): supplies estaticas, reset
- * (gpio 72: baixo 20 ms, alto 20 ms), endereco logico, leitura do chip id.
- * Aqui: "reset-gpios" opcional no no do codec; as supplies ficam a cargo do
- * DT (regulator-always-on em l4/l6), o esqueleto nao as liga.
+ * Not here (yet): headphone/earpiece/lineout, class-H, compander, ANC, MBHC,
+ * TX over SLIMbus, codec interrupts.
  */
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
