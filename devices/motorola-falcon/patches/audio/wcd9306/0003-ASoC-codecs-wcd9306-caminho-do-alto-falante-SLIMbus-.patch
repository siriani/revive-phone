+		       SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_48000 | \
+		       SNDRV_PCM_RATE_96000 | SNDRV_PCM_RATE_192000)
+#define WCD9306_FORMATS (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE)
+
