+static int wcd9306_comp_probe(struct snd_soc_component *comp)
+{
+	struct wcd9306_priv *wcd = dev_get_drvdata(comp->dev);
+	struct snd_soc_dapm_context *dapm = snd_soc_component_get_dapm(comp);
+	int i;
+
+	/* the PGD regmap, whatever device the component sits on */
+	snd_soc_component_init_regmap(comp, wcd->regmap);
+	wcd->component = comp;
+
+	for (i = 0; i < NUM_CODEC_DAIS; i++)
+		INIT_LIST_HEAD(&wcd->dai[i].slim_ch_list);
+
+	wcd9306_codec_init(wcd);
+
+	if (wcd->is_9302) {
+		snd_soc_dapm_new_controls(dapm, wcd9302_rx3_widgets,
+					  ARRAY_SIZE(wcd9302_rx3_widgets));
+		snd_soc_dapm_add_routes(dapm, wcd9302_rx3_routes,
+					ARRAY_SIZE(wcd9302_rx3_routes));
+		return snd_soc_add_component_controls(comp,
+				wcd9302_rx3_controls,
+				ARRAY_SIZE(wcd9302_rx3_controls));
+	}
+	snd_soc_dapm_new_controls(dapm, wcd9306_rx4_widgets,
+				  ARRAY_SIZE(wcd9306_rx4_widgets));
+	snd_soc_dapm_add_routes(dapm, wcd9306_rx4_routes,
+				ARRAY_SIZE(wcd9306_rx4_routes));
+	return snd_soc_add_component_controls(comp, wcd9306_rx4_controls,
+					      ARRAY_SIZE(wcd9306_rx4_controls));
+}
+
+static void wcd9306_comp_remove(struct snd_soc_component *comp)
+{
+	struct wcd9306_priv *wcd = dev_get_drvdata(comp->dev);
+	int i;
+
+	for (i = 0; i < NUM_CODEC_DAIS; i++) {
+		kfree(wcd->dai[i].sconfig.chs);
+		wcd->dai[i].sconfig.chs = NULL;
+	}
+}
+
+static int wcd9306_comp_set_sysclk(struct snd_soc_component *comp,
+				   int clk_id, int source,
+				   unsigned int freq, int dir)
+{
+	struct wcd9306_priv *wcd = dev_get_drvdata(comp->dev);
+
+	if (freq != WCD9306_MCLK_9P6MHZ && freq != WCD9306_MCLK_12P288MHZ)
+		return -EINVAL;
+
+	wcd->mclk_rate = freq;
+	if (wcd->mclk)
+		return clk_set_rate(wcd->mclk, freq);
+	return 0;
+}
