From b1c39dd5873b3b4b6a94e061a7589fe924dc4e4b Mon Sep 17 00:00:00 2001
From: Allan Siriani <allan@fatecpompeia.edu.br>
Date: Wed, 4 Nov 2026 16:12:11 -0300
Subject: [PATCH 2/3] ASoC: dt-bindings: qcom,wcd9306: codec tapan
 (WCD9306/WCD9302)

Descreve o no do PGD do codec tapan no SLIMbus (slim217,e0): MCLK,
reset, alimentacoes (vdd-h, vdd-px, vdd-cx, vdd-buck, vdd-buckhelper) e
#sound-dai-cells. O dispositivo de interface (IFD, dev_index 0) e achado
pelo endereco de enumeracao e nao precisa de no proprio.
---
 .../bindings/sound/qcom,wcd9306.yaml          | 88 +++++++++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/qcom,wcd9306.yaml

diff --git a/Documentation/devicetree/bindings/sound/qcom,wcd9306.yaml b/Documentation/devicetree/bindings/sound/qcom,wcd9306.yaml
new file mode 100644
index 000000000..0d3dbb5d0
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/qcom,wcd9306.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/qcom,wcd9306.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm WCD9306/WCD9302 (tapan) Audio Codec
+
+maintainers:
+  - Allan Siriani <allan@fatecpompeia.edu.br>
+
+description:
+  Qualcomm WCD9306 and its reduced variant WCD9302 (tapan) are audio codecs
+  used with MSM8226/MSM8x26 SoCs. Registers and audio data go over SLIMbus.
+  The node describes the PGD (generic device, dev_index 1); the interface
+  device (IFD, dev_index 0) is reached by the driver through its enumeration
+  address. The variant is read from the codec QFUSE.
+
+properties:
+  compatible:
+    const: slim217,e0
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: mclk
+
+  reset-gpios:
+    maxItems: 1
+
+  slim-ifc-dev:
+    description: SLIMbus interface device (IFD); optional, found by its
+      enumeration address when absent
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  '#sound-dai-cells':
+    const: 1
+
+  vdd-h-supply:
+    description: 1.8 V analog supply (VDD_H)
+
+  vdd-px-supply:
+    description: 1.8 V I/O supply (VDD_PX)
+
+  vdd-cx-supply:
+    description: 1.2 V digital core supply (VDD_CX)
+
+  vdd-buck-supply:
+    description: 1.8-2.15 V supply of the class-H buck and charge pump
+
+  vdd-buckhelper-supply:
+    description: helper supply of the class-H buck
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - $ref: dai-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmcc.h>
+    #include <dt-bindings/gpio/gpio.h>
+
+    slim {
+        #address-cells = <2>;
+        #size-cells = <0>;
+
+        codec@1,0 {
+            compatible = "slim217,e0";
+            reg = <1 0>;
+            clocks = <&rpmcc RPM_SMD_DIV_CLK1>;
+            clock-names = "mclk";
+            reset-gpios = <&tlmm 72 GPIO_ACTIVE_LOW>;
+            vdd-h-supply = <&pm8226_l6>;
+            vdd-px-supply = <&pm8226_l6>;
+            vdd-cx-supply = <&pm8226_l4>;
+            #sound-dai-cells = <1>;
+        };
+    };
-- 
