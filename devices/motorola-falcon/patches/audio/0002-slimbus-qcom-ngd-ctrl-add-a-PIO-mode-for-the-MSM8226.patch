+		if (!time_left || err) {
+			dev_err(sctrl->dev, "PIO TX %s:MC:0x%x,mt:0x%x\n",
+				time_left ? "NACK/error" : "timed out",
+				txn->mc, txn->mt);
+			qcom_slim_ngd_pio_dump(ctrl);
+			mutex_unlock(&ctrl->tx_lock);
+			return time_left ? err : -ETIMEDOUT;
+		}
+	}
 	if (!time_left) {
 		dev_err(sctrl->dev, "TX timed out:MC:0x%x,mt:0x%x", txn->mc,
 					txn->mt);
@@ -1146,10 +1318,44 @@ static int qcom_slim_ngd_exit_dma(struct qcom_slim_ngd_ctrl *ctrl)
 	return 0;
 }
 
+/*
+ * Older NGDs place their register block according to the hardware version
+ * (readable only once the ADSP has powered the bus): version 0 uses the V1
+ * layout (0x800/0xA00), anything else the V2 layout (0x1000/0x2000).
+ * "qcom,ngd-offset" in the DT overrides the detection.
+ */
+static void qcom_slim_ngd_update_base(struct qcom_slim_ngd_ctrl *ctrl)
+{
+	struct qcom_slim_ngd *ngd = ctrl->ngd;
+	void __iomem *base;
+	u32 off;
+
+	if (ctrl->ngd_offset)
+		off = ctrl->ngd_offset;
+	else if (ctrl->ver)
+		off = NGD_BASE_V2(ngd->id);
+	else
+		off = NGD_BASE_V1(ngd->id);
+
+	base = ctrl->base + off;
+	if (base != ngd->base || ctrl->state == QCOM_SLIM_NGD_CTRL_DOWN)
+		dev_info(ctrl->dev, "NGD%d: hw version 0x%x, register offset 0x%x, %s messages\n",
+			 ngd->id, ctrl->ver, off, ctrl->pio ? "PIO" : "BAM");
+	WRITE_ONCE(ngd->base, base);
+}
+
 static void qcom_slim_ngd_setup(struct qcom_slim_ngd_ctrl *ctrl)
 {
 	u32 cfg = readl_relaxed(ctrl->ngd->base);
 
+	if (ctrl->pio) {
+		/* register access mode: NGD on, both message queues off */
+		cfg &= ~(NGD_CFG_RX_MSGQ_EN | NGD_CFG_TX_MSGQ_EN);
+		cfg |= NGD_CFG_ENABLE;
+		writel(cfg, ctrl->ngd->base);
+		return;
+	}
+
 	if (ctrl->state == QCOM_SLIM_NGD_CTRL_DOWN ||
 		ctrl->state == QCOM_SLIM_NGD_CTRL_ASLEEP)
 		qcom_slim_ngd_init_dma(ctrl);
@@ -1193,6 +1399,9 @@ static int qcom_slim_ngd_power_up(struct qcom_slim_ngd_ctrl *ctrl)
 	/* Version info in 16 MSbits */
 	ctrl->ver >>= 16;
 
+	if (ctrl->ver_base)
+		qcom_slim_ngd_update_base(ctrl);
+
 	laddr = readl_relaxed(ngd->base + NGD_STATUS);
 	if (laddr & NGD_LADDR) {
 		/*
@@ -1214,10 +1423,12 @@ static int qcom_slim_ngd_power_up(struct qcom_slim_ngd_ctrl *ctrl)
 	reinit_completion(&ctrl->reconf);
 
 	writel_relaxed(DEF_NGD_INT_MASK, ngd->base + NGD_INT_EN);
-	rx_msgq = readl_relaxed(ngd->base + NGD_RX_MSGQ_CFG);
+	if (!ctrl->pio) {
+		rx_msgq = readl_relaxed(ngd->base + NGD_RX_MSGQ_CFG);
 
-	writel_relaxed(rx_msgq|SLIM_RX_MSGQ_TIMEOUT_VAL,
-				ngd->base + NGD_RX_MSGQ_CFG);
+		writel_relaxed(rx_msgq|SLIM_RX_MSGQ_TIMEOUT_VAL,
+					ngd->base + NGD_RX_MSGQ_CFG);
+	}
 	qcom_slim_ngd_setup(ctrl);
 
 	time_left = wait_for_completion_timeout(&ctrl->reconf, HZ);
@@ -1374,6 +1585,14 @@ static int qcom_slim_ngd_qmi_new_server(struct qmi_handle *hdl,
 
 	complete(&ctrl->qmi_up);
 
