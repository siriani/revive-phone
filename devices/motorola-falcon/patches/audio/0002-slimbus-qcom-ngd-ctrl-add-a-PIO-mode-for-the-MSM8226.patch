+/*
+ * PIO message path. The message is written word by word to NGD_TX_MSG and
+ * the hardware raises NGD_INT_TX_MSG_SENT (or an error) when it is out.
+ * Caller holds tx_lock, so only one message is in flight.
+ */
+static int qcom_slim_ngd_pio_tx(struct qcom_slim_ngd_ctrl *ctrl, u32 *buf,
+				int len, struct completion *comp)
+{
+	void __iomem *tx = ctrl->ngd->base + NGD_TX_MSG;
+	unsigned long flags;
+	int i, words = (len + 3) >> 2;
+
+	if (words > SLIM_MSGQ_BUF_LEN / 4)
+		return -EINVAL;
+
+	spin_lock_irqsave(&ctrl->tx_buf_lock, flags);
+	ctrl->pio_tx_err = 0;
+	ctrl->pio_tx_comp = comp;
+	spin_unlock_irqrestore(&ctrl->tx_buf_lock, flags);
+
+	for (i = 0; i < words; i++)
+		writel_relaxed(buf[i], tx + i * 4);
+	/* make sure the whole message reached the NGD */
+	mb();
+
+	return 0;
+}
+
+static int qcom_slim_ngd_pio_tx_done(struct qcom_slim_ngd_ctrl *ctrl)
+{
+	unsigned long flags;
+	int err;
+
+	spin_lock_irqsave(&ctrl->tx_buf_lock, flags);
+	ctrl->pio_tx_comp = NULL;
+	err = ctrl->pio_tx_err;
+	spin_unlock_irqrestore(&ctrl->tx_buf_lock, flags);
+
+	return err;
+}
+
+static void qcom_slim_ngd_pio_dump(struct qcom_slim_ngd_ctrl *ctrl)
+{
+	void __iomem *ngd = ctrl->ngd->base;
+
+	dev_err(ctrl->dev, "NGD ver:0x%x cfg:0x%x stat:0x%x rxmsgq:0x%x\n",
+		ctrl->ver, readl_relaxed(ngd + NGD_CFG),
+		readl_relaxed(ngd + NGD_STATUS),
+		readl_relaxed(ngd + NGD_RX_MSGQ_CFG));
+	dev_err(ctrl->dev, "NGD int_en:0x%x int_stat:0x%x\n",
+		readl_relaxed(ngd + NGD_INT_EN),
+		readl_relaxed(ngd + NGD_INT_STAT));
+}
+
+static irqreturn_t qcom_slim_ngd_pio_interrupt(struct qcom_slim_ngd_ctrl *ctrl)
+{
+	void __iomem *base;
+	struct completion *comp = NULL;
+	u32 stat, clr;
+
+	/* NGD child not registered yet: nothing of ours can be pending */
+	if (!ctrl->ngd || !ctrl->ctrl.dev)
+		return IRQ_NONE;
+
+	base = READ_ONCE(ctrl->ngd->base);
+	stat = readl_relaxed(base + NGD_INT_STAT);
+	if (!stat)
+		return IRQ_NONE;
+
+	clr = stat & ~NGD_INT_RX_MSG_RCVD;
+	if (clr)
+		writel_relaxed(clr, base + NGD_INT_CLR);
+
+	if (stat & (NGD_INT_ERR_MASK | NGD_INT_TX_MSG_SENT)) {
+		spin_lock(&ctrl->tx_buf_lock);
+		if (stat & NGD_INT_ERR_MASK)
+			ctrl->pio_tx_err = -EIO;
+		comp = ctrl->pio_tx_comp;
+		ctrl->pio_tx_comp = NULL;
+		spin_unlock(&ctrl->tx_buf_lock);
+		if (stat & NGD_INT_ERR_MASK)
+			dev_err(ctrl->dev, "NGD error interrupt 0x%x\n", stat);
+	}
+
+	if (stat & NGD_INT_RX_MSG_RCVD) {
+		u32 rx[SLIM_MSGQ_BUF_LEN / 4];
+		int i, words;
+
+		rx[0] = readl_relaxed(base + NGD_RX_MSG);
+		words = ((rx[0] & 0x1f) + 3) >> 2;
+		if (words > ARRAY_SIZE(rx))
+			words = ARRAY_SIZE(rx);
+		for (i = 1; i < words; i++)
+			rx[i] = readl_relaxed(base + NGD_RX_MSG + i * 4);
+		writel_relaxed(NGD_INT_RX_MSG_RCVD, base + NGD_INT_CLR);
+		/* clear must land before the next message can be latched */
+		mb();
+		dev_dbg(ctrl->dev, "PIO RX 0x%08x 0x%08x\n", rx[0],
+			words > 1 ? rx[1] : 0);
+		qcom_slim_ngd_rx(ctrl, (u8 *)rx);
+	} else {
+		mb();
+	}
+
+	if (stat & NGD_INT_RECFG_DONE)
+		dev_dbg(ctrl->dev, "reconfig done\n");
+	if (stat & NGD_INT_IE_VE_CHG)
+		dev_info(ctrl->dev, "NGD IE/VE change\n");
+
+	if (comp)
+		complete(comp);
+
+	return IRQ_HANDLED;
+}
+
 static irqreturn_t qcom_slim_ngd_interrupt(int irq, void *d)
 {
