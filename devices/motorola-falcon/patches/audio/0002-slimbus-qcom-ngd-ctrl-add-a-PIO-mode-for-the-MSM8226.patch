 #define	NGD_INT_TX_MSG_SENT	BIT(31)
 #define	NGD_INT_STAT		0x14
 #define	NGD_INT_CLR		0x18
+/* Register (PIO) message access, used by older NGDs (e.g. MSM8226) */
+#define	NGD_TX_MSG		0x30
