@@ -811,7 +962,12 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 		return -EINVAL;
 	}
 
-	pbuf = qcom_slim_ngd_tx_msg_get(ctrl, txn->rl, &tx_sent);
+	if (ctrl->pio) {
+		memset(pio_buf, 0, sizeof(pio_buf));
+		pbuf = pio_buf;
+	} else {
+		pbuf = qcom_slim_ngd_tx_msg_get(ctrl, txn->rl, &tx_sent);
+	}
 	if (!pbuf) {
 		dev_err(ctrl->dev, "Message buffer unavailable\n");
 		return -ENOMEM;
@@ -885,13 +1041,29 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 		memcpy(puc, txn->msg->wbuf, txn->msg->num_bytes);
 
 	mutex_lock(&ctrl->tx_lock);
-	ret = qcom_slim_ngd_tx_msg_post(ctrl, pbuf, txn->rl);
+	if (ctrl->pio)
+		ret = qcom_slim_ngd_pio_tx(ctrl, pbuf, txn->rl, &tx_sent);
+	else
+		ret = qcom_slim_ngd_tx_msg_post(ctrl, pbuf, txn->rl);
 	if (ret) {
 		mutex_unlock(&ctrl->tx_lock);
 		return ret;
 	}
 
 	time_left = wait_for_completion_timeout(&tx_sent, HZ);
+	if (ctrl->pio) {
+		/* drop the on-stack completion before anything else */
+		int err = qcom_slim_ngd_pio_tx_done(ctrl);
