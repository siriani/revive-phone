From 398bf955e9a560c28319bf9f0b77c4bbfd4c1ca0 Mon Sep 17 00:00:00 2001
From: Allan Siriani <allan@fatecpompeia.edu.br>
Date: Wed, 4 Nov 2026 00:12:16 -0300
Subject: [PATCH 1/3] dt-bindings: media: qcom,msm8916-camss: add MSM8226
 compatible

The MSM8226 CAMSS block has the same clock, register, interrupt and
port layout as the MSM8916 one, with two CSIPHY, two CSID, one ISPIF and
one VFE, so the existing schema applies unchanged.

Signed-off-by: Allan Siriani <allan@fatecpompeia.edu.br>
---
 .../devicetree/bindings/media/qcom,msm8916-camss.yaml         | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/media/qcom,msm8916-camss.yaml b/Documentation/devicetree/bindings/media/qcom,msm8916-camss.yaml
index 7c8e0a905..738fcf5f0 100644
--- a/Documentation/devicetree/bindings/media/qcom,msm8916-camss.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,msm8916-camss.yaml
@@ -15,7 +15,9 @@ description: |
 
 properties:
   compatible:
-    const: qcom,msm8916-camss
+    enum:
+      - qcom,msm8916-camss
+      - qcom,msm8226-camss
 
   clocks:
     minItems: 19
-- 
