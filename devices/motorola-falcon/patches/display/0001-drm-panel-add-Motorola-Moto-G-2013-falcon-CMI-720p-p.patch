From ff8b85b96336ceda6943aa630cc101b7b1f14279 Mon Sep 17 00:00:00 2001
From: Allan Siriani <allan@fatecpompeia.edu.br>
Date: Wed, 4 Nov 2026 11:41:10 -0300
Subject: [PATCH] drm/panel: add Motorola Moto G 2013 (falcon) CMI 720p panel
 driver

Add a driver for the CMI 720x1280 video mode DSI panel of the Motorola
Moto G 2013 (falcon), downstream name "mipi_mot_video_cmi_hd_450 v2".

The init sequence was generated with linux-mdss-dsi-panel-driver-generator
from the vendor device tree. Power and reset follow the vendor
qcom,mdss_dsi node:
- vddio_disp (1.8 V load switch on GPIO 34) and 2 ms, vdd (l28), then
  the TPS65132 bias (vsp/vsn) and 11 ms; reverse order on power off;
- reset on GPIO 25, active high: high for 11 ms on enable, low for 3 ms
  on disable;
- pixel clock 66467 kHz (797.6 MHz bit clock, 2 lanes, 24 bpp, 60 Hz).

Tested on an XT1033 with the msm DRM driver and the PM8226 WLED as
backlight.

Signed-off-by: Allan Siriani <allan@fatecpompeia.edu.br>
---
 drivers/gpu/drm/panel/Kconfig                 |   9 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-motorola-falcon-cmi.c | 285 ++++++++++++++++++
 3 files changed, 295 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-motorola-falcon-cmi.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 0668c759e..bcf3d4486 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -417,6 +417,15 @@ config DRM_PANEL_MAGNACHIP_D53E6EA8966
 	  with the Magnachip D53E6EA8966 panel IC. This panel receives
 	  video data via DSI but commands via 9-bit SPI using DBI.
 
+config DRM_PANEL_MOTOROLA_FALCON_CMI
+	tristate "Motorola Moto G 2013 (falcon) CMI 720p panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y or M here to enable support for the CMI 720p video mode DSI
+	  panel used in the Motorola Moto G 2013 (falcon).
+
 config DRM_PANEL_MANTIX_MLAF057WE51
 	tristate "Mantix MLAF057WE51-X MIPI-DSI LCD panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index a8b188a17..b0137e0d4 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -53,6 +53,7 @@ obj-$(CONFIG_DRM_PANEL_NOVATEK_NT36672A) += panel-novatek-nt36672a.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT36672E) += panel-novatek-nt36672e.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT37801) += panel-novatek-nt37801.o
 obj-$(CONFIG_DRM_PANEL_NOVATEK_NT39016) += panel-novatek-nt39016.o
+obj-$(CONFIG_DRM_PANEL_MOTOROLA_FALCON_CMI) += panel-motorola-falcon-cmi.o
 obj-$(CONFIG_DRM_PANEL_MANTIX_MLAF057WE51) += panel-mantix-mlaf057we51.o
 obj-$(CONFIG_DRM_PANEL_OLIMEX_LCD_OLINUXINO) += panel-olimex-lcd-olinuxino.o
 obj-$(CONFIG_DRM_PANEL_ORISETECH_OTA5601A) += panel-orisetech-ota5601a.o
diff --git a/drivers/gpu/drm/panel/panel-motorola-falcon-cmi.c b/drivers/gpu/drm/panel/panel-motorola-falcon-cmi.c
new file mode 100644
index 000000000..205e6cb17
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-motorola-falcon-cmi.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CMI 720p video mode DSI panel of the Motorola Moto G 2013 (falcon),
+ * downstream name "mipi_mot_video_cmi_hd_450 v2" (manufacturer id 0xc2,
+ * controller version 0x86).
+ *
+ * Init sequence generated with linux-mdss-dsi-panel-driver-generator from the
+ * vendor device tree; power and reset sequence taken from the vendor
+ * qcom,mdss_dsi node (vddio_disp switch, l28, TPS65132 bias, reset on gpio 25).
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+/*
+ * Ordem de energia do original (qcom,platform-supply-entry do painel):
+ * vddio_disp (1,8 V, GPIO 34 sobre l8) com 2 ms depois; vdd_disp (l28);
+ * lcdbias (TPS65132 +/-5,4 V, outp/outn) com 11 ms depois. O vdda (l4) do
+ * DSI fica no host (vdda-supply de mdss_dsi0).
+ */
+enum falcon_cmi_supply {
+	FALCON_CMI_VDDIO,
+	FALCON_CMI_VDD,
+	FALCON_CMI_VSP,
+	FALCON_CMI_VSN,
+	FALCON_CMI_NUM_SUPPLIES,
+};
+
+static const char * const falcon_cmi_supplies[] = {
+	[FALCON_CMI_VDDIO] = "vddio",	/* vddio_disp: 1.8 V load switch */
+	[FALCON_CMI_VDD] = "vdd",	/* vdd_disp: l28 */
+	[FALCON_CMI_VSP] = "vsp",	/* TPS65132 positive bias */
+	[FALCON_CMI_VSN] = "vsn",	/* TPS65132 negative bias */
+};
+
+struct falcon_cmi {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(falcon_cmi_supplies)];
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct falcon_cmi *to_falcon_cmi(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct falcon_cmi, panel);
+}
+
+static int falcon_cmi_power_on(struct falcon_cmi *ctx)
+{
+	struct regulator_bulk_data *s = ctx->supplies;
+	int ret;
+
+	ret = regulator_bulk_enable(1, &s[FALCON_CMI_VDDIO]);
+	if (ret)
+		return ret;
+	msleep(2);	/* qcom,supply-post-on-sleep = <2> (vddio_disp) */
+
+	ret = regulator_bulk_enable(1, &s[FALCON_CMI_VDD]);
+	if (ret)
+		goto err_vddio;
+
+	ret = regulator_bulk_enable(2, &s[FALCON_CMI_VSP]);
+	if (ret)
+		goto err_vdd;
+	msleep(11);	/* qcom,supply-post-on-sleep = <11> (lcdbias) */
+
+	return 0;
+
+err_vdd:
+	regulator_bulk_disable(1, &s[FALCON_CMI_VDD]);
+err_vddio:
+	regulator_bulk_disable(1, &s[FALCON_CMI_VDDIO]);
+	return ret;
+}
+
+static void falcon_cmi_power_off(struct falcon_cmi *ctx)
+{
+	struct regulator_bulk_data *s = ctx->supplies;
+
+	regulator_bulk_disable(2, &s[FALCON_CMI_VSP]);
+	msleep(2);	/* qcom,supply-post-off-sleep = <2> (lcdbias) */
+	regulator_bulk_disable(2, &s[FALCON_CMI_VDDIO]);	/* vddio + vdd */
+}
+
+static void falcon_cmi_reset(struct falcon_cmi *ctx, int level, unsigned int ms)
+{
+	/*
+	 * Downstream: panel-en-reset-sequence = <1 11> (linha em nivel alto,
+	 * 11 ms) e panel-dis-reset-sequence = <0 3>. GPIO 25 ativo alto.
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, level);
+	msleep(ms);
+}
+
+static int falcon_cmi_on(struct falcon_cmi *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x4c, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xff, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x3b, 0x03, 0x04, 0x03);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x11, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x51, 0xff);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0x2c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x35, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x55, 0x92);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x29, 0x00);
+
+	return dsi_ctx.accum_err;
+}
+
+static int falcon_cmi_off(struct falcon_cmi *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	return dsi_ctx.accum_err;
+}
+
+static int falcon_cmi_prepare(struct drm_panel *panel)
+{
+	struct falcon_cmi *ctx = to_falcon_cmi(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = falcon_cmi_power_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	falcon_cmi_reset(ctx, 1, 11);	/* panel-en-reset-sequence <1 11> */
+
+	ret = falcon_cmi_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		falcon_cmi_reset(ctx, 0, 3);	/* panel-dis-reset-sequence <0 3> */
+		falcon_cmi_power_off(ctx);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int falcon_cmi_unprepare(struct drm_panel *panel)
+{
+	struct falcon_cmi *ctx = to_falcon_cmi(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = falcon_cmi_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	falcon_cmi_reset(ctx, 0, 3);	/* panel-dis-reset-sequence <0 3> */
+	falcon_cmi_power_off(ctx);
+
+	return 0;
+}
+
+static const struct drm_display_mode falcon_cmi_mode = {
+	/*
+	 * Downstream: qcom,mdss-dsi-panel-clockrate = 797.6 MHz de bit clock,
+	 * 2 lanes, 24 bpp -> 66466,67 kHz de pixel (60 Hz).
+	 */
+	.clock = 66467,
+	.hdisplay = 720,
+	.hsync_start = 720 + 64,
+	.hsync_end = 720 + 64 + 8,
+	.htotal = 720 + 64 + 8 + 64,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 6,
+	.vsync_end = 1280 + 6 + 1,
+	.vtotal = 1280 + 6 + 1 + 7,
+	.width_mm = 56,
+	.height_mm = 99,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int falcon_cmi_get_modes(struct drm_panel *panel,
+				struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &falcon_cmi_mode);
+}
+
+static const struct drm_panel_funcs falcon_cmi_panel_funcs = {
+	.prepare = falcon_cmi_prepare,
+	.unprepare = falcon_cmi_unprepare,
+	.get_modes = falcon_cmi_get_modes,
+};
+
+static void falcon_cmi_panel_remove(void *panel)
+{
+	drm_panel_remove(panel);
+}
+
+static int falcon_cmi_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct falcon_cmi *ctx;
+	int i, ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct falcon_cmi, panel,
+				   &falcon_cmi_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	for (i = 0; i < ARRAY_SIZE(falcon_cmi_supplies); i++)
+		ctx->supplies[i].supply = falcon_cmi_supplies[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	/*
+	 * GPIO 25 e ativo alto no original (flags 0): nivel alto = fora de reset.
+	 * O bootloader deixa o painel rodando, entao comeca em alto.
+	 */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE |
+			  MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+	ret = devm_add_action_or_reset(dev, falcon_cmi_panel_remove, &ctx->panel);
+	if (ret)
+		return ret;
+
+	return devm_mipi_dsi_attach(dev, dsi);
+}
+
+static const struct of_device_id falcon_cmi_of_match[] = {
+	{ .compatible = "motorola,falcon-panel-cmi" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, falcon_cmi_of_match);
+
+static struct mipi_dsi_driver falcon_cmi_driver = {
+	.probe = falcon_cmi_probe,
+	.driver = {
+		.name = "panel-motorola-falcon-cmi",
+		.of_match_table = falcon_cmi_of_match,
+	},
+};
+module_mipi_dsi_driver(falcon_cmi_driver);
+
+MODULE_AUTHOR("Allan Siriani <allan@fatecpompeia.edu.br>");
+MODULE_DESCRIPTION("DRM driver for the Motorola Moto G 2013 (falcon) CMI 720p panel");
+MODULE_LICENSE("GPL");
-- 
2.43.0

