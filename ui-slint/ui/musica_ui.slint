// Revive: telas de música (Slint). Paisagem 1280x720, renderizador por software.
// Três componentes: tela "tocando agora", fila de reprodução e trilho de navegação.
// Tudo com x/y explícitos (sem layouts), fontes só 26/34/44px, alvos de toque >= 64px.

import { AppBar, FloatingActionButton, FABStyle, Slider } from "@material";
import { Tema } from "tema.slint";

export struct Album { id: string, nome: string, artista: string, capa: image }
export struct FilaItem { titulo: string, artista: string, tocando: bool }

// Botão de ícone próprio (o IconButton do Material não aceita cor), 72x72 com ícone tingido.
component BotaoIcone inherits Rectangle {
    in property <image> icone;
    in property <color> cor: Tema.texto-sec;
    callback clicado();

    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: toque.pressed ? Tema.toque : #00000000;

    Image {
        x: 18px;
        y: 18px;
        width: 36px;
        height: 36px;
        source: root.icone;
        colorize: root.cor;
        image-fit: contain;
    }

    toque := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.clicado(); }
    }
}

// Item do trilho de navegação (Material 3): pílula 64x36 atrás do ícone 40px + rótulo 24px.
component ItemTrilho inherits Rectangle {
    in property <image> icone;
    in property <string> rotulo;
    in property <bool> ativo;
    callback clicado();

    width: 120px;
    height: 84px;
    background: #00000000;

    Rectangle {
        x: 28px;
        y: 6px;
        width: 64px;
        height: 36px;
        border-radius: 18px;
        background: root.ativo ? Tema.destaque-suave : #00000000;
    }

    Image {
        x: 40px;
        y: 4px;
        width: 40px;
        height: 40px;
        source: root.icone;
        colorize: root.ativo ? Tema.sobre-destaque-suave : Tema.texto-sec;
        image-fit: contain;
    }

    Text {
        x: 0px;
        y: 48px;
        width: 120px;
        height: 32px;
        text: root.rotulo;
        font-size: 24px;
        font-family: root.ativo ? "DejaVu Sans Bold" : "DejaVu Sans";
        color: root.ativo ? Tema.texto : Tema.texto-sec;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.clicado(); }
    }
}

// ---------------------------------------------------------------- tocando agora

export component TelaTocandoMat inherits Rectangle {
    in property <string> titulo;
    in property <string> artista;
    in property <string> album;
    in property <image> capa;
    // in-out: o Slider escreve o valor ao arrastar; com in-out o binding continua vivo
    in-out property <float> progresso;
    in property <string> tempo;
    in property <string> duracao;
    in property <bool> pausa;
    in property <bool> aleatorio;
    in property <string> repetir;
    in property <bool> favorita;
    // in-out pelo mesmo motivo de progresso
    in-out property <float> volume;

    callback controle(string);
    callback pular(float);
    callback volume-mudar(float);

    width: 1280px;
    height: 720px;
    background: Tema.fundo;

    AppBar {
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 96px;
        title: @tr("Tocando agora");
        leading_button: { icon: @image-url("icones/arrow_back.svg"), enabled: true };
        trailing_button: { icon: @image-url("icones/queue_music.svg"), enabled: true };
        leading_button_clicked => { root.controle("voltar"); }
        trailing_button_clicked => { root.controle("fila"); }
    }

    // capa 520x520 com cantos arredondados
    Rectangle {
        x: 40px;
        y: 110px;
        width: 520px;
        height: 520px;
        border-radius: Tema.raio-g;
        clip: true;
        background: Tema.superficie;

        Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: root.capa;
            image-fit: cover;
        }
    }

    // título
    Text {
        x: 620px;
        y: 110px;
        width: 620px;
        height: 56px;
        text: root.titulo;
        font-size: Tema.texto-cabecalho;
        font-family: "DejaVu Sans Bold";
        color: Tema.texto;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }

    // artista (tocável)
    Rectangle {
        x: 620px;
        y: 176px;
        width: 620px;
        height: 64px;
        background: #00000000;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.artista;
            font-size: Tema.texto-corpo;
            color: Tema.destaque;
            overflow: elide;
            wrap: no-wrap;
            vertical-alignment: center;
        }
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.controle("artista"); }
        }
    }

    // álbum (tocável)
    Rectangle {
        x: 620px;
        y: 240px;
        width: 620px;
        height: 64px;
        background: #00000000;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.album;
            font-size: Tema.texto-corpo;
            color: Tema.destaque;
            overflow: elide;
            wrap: no-wrap;
            vertical-alignment: center;
        }
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.controle("album"); }
        }
    }

    // progresso
    Slider {
        x: 620px;
        y: 312px;
        width: 620px;
        height: 64px;
        enabled: true;
        minimum: 0;
        maximum: 1;
        value <=> root.progresso;
        value_changed(v) => { root.pular(v); }
    }

    Text {
        x: 620px;
        y: 376px;
        width: 200px;
        height: 40px;
        text: root.tempo;
        font-size: Tema.texto-corpo;
        color: Tema.texto-sec;
        vertical-alignment: center;
    }

    Text {
        x: 1040px;
        y: 376px;
        width: 200px;
        height: 40px;
        text: root.duracao;
        font-size: Tema.texto-corpo;
        color: Tema.texto-sec;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // controles: aleatório, anterior, play/pausa (FAB), próxima, repetir
    BotaoIcone {
        x: 634px;
        y: 430px;
        icone: @image-url("icones/shuffle.svg");
        cor: root.aleatorio ? Tema.destaque : Tema.texto-sec;
        clicado => { root.controle("aleatorio"); }
    }

    BotaoIcone {
        x: 764px;
        y: 430px;
        icone: @image-url("icones/skip_previous.svg");
        cor: Tema.texto;
        clicado => { root.controle("anterior"); }
    }

    FloatingActionButton {
        x: 885px;
        y: 394px;
        style: FABStyle.large;
        icon: root.pausa ? @image-url("icones/play_arrow.svg") : @image-url("icones/pause.svg");
        clicked => { root.controle("pausar"); }
    }

    BotaoIcone {
        x: 1024px;
        y: 430px;
        icone: @image-url("icones/skip_next.svg");
        cor: Tema.texto;
        clicado => { root.controle("proxima"); }
    }

    BotaoIcone {
        x: 1154px;
        y: 430px;
        icone: root.repetir == "uma" ? @image-url("icones/repeat_one.svg") : @image-url("icones/repeat.svg");
        cor: root.repetir != "nao" ? Tema.destaque : Tema.texto-sec;
        clicado => { root.controle("repetir"); }
    }

    // curtir + volume
    BotaoIcone {
        x: 620px;
        y: 560px;
        icone: root.favorita ? @image-url("icones/favorite_fill.svg") : @image-url("icones/favorite.svg");
        cor: root.favorita ? Tema.erro : Tema.texto-sec;
        clicado => { root.controle("favoritar"); }
    }

    Image {
        x: 720px;
        y: 578px;
        width: 36px;
        height: 36px;
        source: @image-url("icones/volume_up.svg");
        colorize: Tema.texto-sec;
        image-fit: contain;
    }

    Slider {
        x: 780px;
        y: 560px;
        width: 460px;
        height: 64px;
        enabled: true;
        minimum: 0;
        maximum: 1;
        value <=> root.volume;
        value_changed(v) => { root.volume-mudar(v); }
    }
}

// ---------------------------------------------------------------- fila

export component TelaFila inherits Rectangle {
    in property <[FilaItem]> itens;

    callback tocar(int);
    callback remover(int);
    callback voltar();

    width: 1280px;
    height: 720px;
    background: Tema.fundo;

    AppBar {
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 96px;
        title: @tr("Fila");
        leading_button: { icon: @image-url("icones/arrow_back.svg"), enabled: true };
        leading_button_clicked => { root.voltar(); }
    }

    Text {
        x: 0px;
        y: 300px;
        width: 1280px;
        height: 60px;
        visible: root.itens.length == 0;
        text: @tr("Fila vazia");
        font-size: Tema.texto-titulo;
        color: Tema.texto-sec;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Flickable {
        x: 0px;
        y: 96px;
        width: 1280px;
        height: 624px;
        content-height: root.itens.length * 96px;

        for item[i] in root.itens: Rectangle {
            x: 0px;
            y: i * 96px;
            width: 1280px;
            height: 96px;
            background: item.tocando ? Tema.destaque-suave : #00000000;

            Text {
                x: 24px;
                y: 0px;
                width: 56px;
                height: 96px;
                text: "\{i + 1}";
                font-size: Tema.texto-corpo;
                color: item.tocando ? Tema.destaque : Tema.texto-sec;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 96px;
                y: 8px;
                width: 980px;
                height: 42px;
                text: item.titulo;
                font-size: Tema.texto-corpo;
                font-family: item.tocando ? "DejaVu Sans Bold" : "DejaVu Sans";
                color: item.tocando ? Tema.sobre-destaque-suave : Tema.texto;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }

            Text {
                x: 96px;
                y: 50px;
                width: 980px;
                height: 38px;
                text: item.artista;
                font-size: Tema.texto-corpo;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }

            if item.tocando: Image {
                x: 1084px;
                y: 30px;
                width: 36px;
                height: 36px;
                source: @image-url("icones/equalizer.svg");
                colorize: Tema.destaque;
                image-fit: contain;
            }

            TouchArea {
                x: 0px;
                y: 0px;
                width: 1280px;
                height: 96px;
                clicked => { root.tocar(i); }
            }

            BotaoIcone {
                x: 1192px;
                y: 12px;
                icone: @image-url("icones/close.svg");
                cor: Tema.texto-sec;
                clicado => { root.remover(i); }
            }
        }
    }
}

// ---------------------------------------------------------------- trilho

// trilho lateral 120x720: voltar, seis destinos no topo e Ajustes fixo no rodapé
export component RailMusica inherits Rectangle {
    in property <string> atual;
    callback ir(string);

    width: 120px;
    height: 720px;
    background: Tema.superficie-baixa;

    BotaoIcone {
        x: 24px;
        y: 8px;
        icone: @image-url("icones/arrow_back.svg");
        clicado => { root.ir("revive"); }
    }

    ItemTrilho {
        x: 0px;
        y: 96px;
        icone: @image-url("icones/home.svg");
        rotulo: @tr("Início");
        ativo: root.atual == "home";
        clicado => { root.ir("home"); }
    }

    ItemTrilho {
        x: 0px;
        y: 180px;
        icone: @image-url("icones/search.svg");
        rotulo: @tr("Buscar");
        ativo: root.atual == "buscar";
        clicado => { root.ir("buscar"); }
    }

    ItemTrilho {
        x: 0px;
        y: 264px;
        icone: @image-url("icones/person.svg");
        rotulo: @tr("Artistas");
        ativo: root.atual == "artistas";
        clicado => { root.ir("artistas"); }
    }

    ItemTrilho {
        x: 0px;
        y: 348px;
        icone: @image-url("icones/library_music.svg");
        rotulo: @tr("Playlists");
        ativo: root.atual == "playlists";
        clicado => { root.ir("playlists"); }
    }

    ItemTrilho {
        x: 0px;
        y: 432px;
        icone: @image-url("icones/favorite.svg");
        rotulo: @tr("Favoritas");
        ativo: root.atual == "favoritas";
        clicado => { root.ir("favoritas"); }
    }

    ItemTrilho {
        x: 0px;
        y: 516px;
        icone: @image-url("icones/queue_music.svg");
        rotulo: @tr("Fila");
        ativo: root.atual == "fila";
        clicado => { root.ir("fila"); }
    }

    ItemTrilho {
        x: 0px;
        y: 630px;
        icone: @image-url("icones/settings.svg");
        rotulo: @tr("Ajustes");
        ativo: root.atual == "ajustes";
        clicado => { root.ir("ajustes"); }
    }
}

// ---------------------------------------------------------------- mini player

// cartão "tocando agora" flutuante (altura 84px; largura definida por quem usa)
export component MiniPlayer inherits Rectangle {
    in property <bool> ativo;
    in property <string> titulo;
    in property <string> artista;
    in property <image> capa;
    in property <bool> pausa;
    in property <float> progresso;
    callback controle(string);
    callback abrir();

    height: 84px;
    border-radius: 20px;
    background: Tema.superficie-alta;
    drop-shadow-blur: 12px;
    drop-shadow-color: #0006;
    drop-shadow-offset-y: 2px;
    visible: root.ativo;

    // toque no cartão inteiro; os botões (declarados depois) ficam por cima
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.abrir(); }
    }

    Rectangle {
        x: 10px;
        y: 10px;
        width: 64px;
        height: 64px;
        border-radius: 10px;
        clip: true;
        background: Tema.superficie;
        Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: root.capa;
            image-fit: cover;
        }
    }

    Text {
        x: 88px;
        y: 12px;
        width: root.width - 260px;
        height: 34px;
        text: root.titulo;
        font-size: 26px;
        font-family: "DejaVu Sans Bold";
        color: Tema.texto;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }

    Text {
        x: 88px;
        y: 46px;
        width: root.width - 260px;
        height: 28px;
        text: root.artista;
        font-size: 21px;
        color: Tema.texto-sec;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }

    BotaoIcone {
        x: root.width - 164px;
        y: 4px;
        icone: root.pausa ? @image-url("icones/play_arrow.svg") : @image-url("icones/pause.svg");
        cor: Tema.texto;
        clicado => { root.controle("pausar"); }
    }

    BotaoIcone {
        x: root.width - 88px;
        y: 4px;
        icone: @image-url("icones/skip_next.svg");
        cor: Tema.texto;
        clicado => { root.controle("proxima"); }
    }

    // progresso: linha de 4px no rodapé interno
    Rectangle {
        x: 20px;
        y: 76px;
        width: (root.width - 40px) * max(0, min(1, root.progresso));
        height: 4px;
        border-radius: 2px;
        background: Tema.destaque;
    }
}

// ---------------------------------------------------------------- início (Material)

// chip de ação do cabeçalho: pílula com contorno, ícone 28px + texto 24px
component Chip inherits Rectangle {
    in property <image> icone;
    in property <string> texto;
    callback clicado();

    height: 52px;
    border-radius: 26px;
    border-width: 1px;
    border-color: Tema.contorno;
    background: toque.pressed ? Tema.superficie-alta : #00000000;

    Image {
        x: 20px;
        y: 12px;
        width: 28px;
        height: 28px;
        source: root.icone;
        colorize: Tema.texto;
        image-fit: contain;
    }

    Text {
        x: 58px;
        y: 0px;
        width: root.width - 78px;
        height: 52px;
        text: root.texto;
        font-size: 24px;
        color: Tema.texto;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }

    toque := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.clicado(); }
    }
}

// prateleira horizontal de capas 200x200; some (altura 0) quando a lista está vazia
component Prateleira inherits Rectangle {
    in property <string> titulo;
    in property <[Album]> albuns;
    callback abrir(int);

    height: root.albuns.length > 0 ? 346px : 0px;
    clip: true;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 44px;
        text: root.titulo;
        font-size: 34px;
        font-family: "DejaVu Sans Bold";
        color: Tema.texto;
        overflow: elide;
        wrap: no-wrap;
        vertical-alignment: center;
    }

    Flickable {
        x: 0px;
        y: 52px;
        width: parent.width;
        height: 270px;
        content-width: max(parent.width, root.albuns.length * 220px);
        content-height: 270px;

        for a[i] in root.albuns: Rectangle {
            x: i * 220px;
            y: 0px;
            width: 200px;
            height: 270px;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 200px;
                height: 200px;
                border-radius: 16px;
                clip: true;
                background: Tema.superficie;
                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: a.capa;
                    image-fit: cover;
                }
            }

            if toque.pressed: Rectangle {
                x: 0px;
                y: 0px;
                width: 200px;
                height: 200px;
                border-radius: 16px;
                background: Tema.toque;
            }

            Text {
                x: 0px;
                y: 208px;
                width: 200px;
                height: 30px;
                text: a.nome;
                font-size: 24px;
                font-family: "DejaVu Sans Bold";
                color: Tema.texto;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }

            Text {
                x: 0px;
                y: 240px;
                width: 200px;
                height: 26px;
                text: a.artista;
                font-size: 21px;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }

            toque := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.abrir(i); }
            }
        }
    }
}

// tela inicial de música: trilho à esquerda, conteúdo rolável à direita (x 120..1280)
export component MusicaInicioMat inherits Rectangle {
    in property <[Album]> recentes;
    in property <[Album]> frequentes;
    in property <[Album]> novidades;
    in property <[Album]> aleatorios;
    in property <string> mensagem;
    in property <string> saudacao: @tr("Olá");
    in property <bool> toc-ativo;
    callback abrir-album(string, int);
    callback navegar(string);

    width: 1280px;
    height: 720px;
    background: Tema.fundo;

    RailMusica {
        x: 0px;
        y: 0px;
        atual: "home";
        ir(k) => { root.navegar(k); }
    }

    Flickable {
        x: 120px;
        y: 0px;
        width: 1160px;
        height: 720px;
        visible: root.mensagem == "";
        content-width: 1160px;
        // folga no fim para o MiniPlayer não cobrir a última prateleira
        content-height: s3.y + s3.height + 24px + (root.toc-ativo ? 110px : 0px);

        // cabeçalho
        Text {
            x: 32px;
            y: 24px;
            width: 640px;
            height: 56px;
            text: root.saudacao;
            font-size: 44px;
            font-family: "DejaVu Sans Bold";
            color: Tema.texto;
            overflow: elide;
            wrap: no-wrap;
            vertical-alignment: center;
        }

        Chip {
            x: 692px;
            y: 26px;
            width: 220px;
            icone: @image-url("icones/shuffle.svg");
            texto: @tr("Aleatórias");
            clicado => { root.navegar("aleatorias"); }
        }

        Chip {
            x: 928px;
            y: 26px;
            width: 200px;
            icone: @image-url("icones/favorite.svg");
            texto: @tr("Favoritas");
            clicado => { root.navegar("favoritas"); }
        }

        // acesso rápido: grade 3x2 com os seis primeiros de recentes
        Text {
            x: 32px;
            y: 104px;
            width: 1096px;
            height: 44px;
            visible: root.recentes.length > 0;
            text: @tr("Acesso rápido");
            font-size: 34px;
            font-family: "DejaVu Sans Bold";
            color: Tema.texto;
            vertical-alignment: center;
        }

        Rectangle {
            x: 32px;
            y: 160px;
            width: 1096px;
            height: root.recentes.length > 0 ? 192px : 0px;

            for a[i] in root.recentes: Rectangle {
                x: mod(i, 3) * 370px;
                y: floor(i / 3) * 104px;
                width: 354px;
                height: 88px;
                visible: i < 6;
                border-radius: 12px;
                clip: true;
                background: toque.pressed ? Tema.superficie-alta : Tema.superficie;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 88px;
                    height: 88px;
                    border-radius: 12px;
                    clip: true;
                    background: Tema.superficie-alta;
                    Image {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        source: a.capa;
                        image-fit: cover;
                    }
                }

                Text {
                    x: 100px;
                    y: 14px;
                    width: 242px;
                    height: 34px;
                    text: a.nome;
                    font-size: 24px;
                    font-family: "DejaVu Sans Bold";
                    color: Tema.texto;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }

                Text {
                    x: 100px;
                    y: 50px;
                    width: 242px;
                    height: 26px;
                    text: a.artista;
                    font-size: 21px;
                    color: Tema.texto-sec;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }

                toque := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.abrir-album("recentes", i); }
                }
            }
        }

        // prateleiras: cada uma começa onde a anterior termina (altura 0 quando vazia)
        s1 := Prateleira {
            x: 32px;
            y: root.recentes.length > 0 ? 376px : 112px;
            width: 1096px;
            titulo: @tr("Mais tocados");
            albuns: root.frequentes;
            abrir(i) => { root.abrir-album("frequentes", i); }
        }

        s2 := Prateleira {
            x: 32px;
            y: s1.y + s1.height;
            width: 1096px;
            titulo: @tr("Adicionados recentemente");
            albuns: root.novidades;
            abrir(i) => { root.abrir-album("novidades", i); }
        }

        s3 := Prateleira {
            x: 32px;
            y: s2.y + s2.height;
            width: 1096px;
            titulo: @tr("Descubra");
            albuns: root.aleatorios;
            abrir(i) => { root.abrir-album("aleatorios", i); }
        }
    }

    // mensagem no lugar do conteúdo (ex.: nenhuma música configurada)
    Text {
        x: 152px;
        y: 240px;
        width: 1096px;
        height: 120px;
        visible: root.mensagem != "";
        text: root.mensagem;
        font-size: 34px;
        color: Tema.texto-sec;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    Rectangle {
        x: 550px;
        y: 380px;
        width: 300px;
        height: 72px;
        border-radius: 36px;
        visible: root.mensagem != "";
        background: bt.pressed ? Tema.destaque-suave : Tema.destaque;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: @tr("Configurar");
            font-size: 26px;
            font-family: "DejaVu Sans Bold";
            color: Tema.sobre-destaque;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        bt := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.navegar("ajustes"); }
        }
    }

    // embutir glifos (não aparece na tela): caracteres dos textos dinâmicos, nos tamanhos usados
    Text {
        visible: false;
        text: "áàâãéêíóôõúçÁÉÍÓÚÇñü abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ()[]-–—:'’&.,!?/";
        font-size: 24px;
    }
    Text {
        visible: false;
        text: "áàâãéêíóôõúçÁÉÍÓÚÇñü abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ()[]-–—:'’&.,!?/";
        font-size: 24px;
        font-family: "DejaVu Sans Bold";
    }
    Text {
        visible: false;
        text: "áàâãéêíóôõúçÁÉÍÓÚÇñü abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ()[]-–—:'’&.,!?/";
        font-size: 21px;
    }
    Text {
        visible: false;
        text: "áàâãéêíóôõúçÁÉÍÓÚÇñü abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ()[]-–—:'’&.,!?/";
        font-size: 26px;
        font-family: "DejaVu Sans Bold";
    }
    Text {
        visible: false;
        text: "áàâãéêíóôõúçÁÉÍÓÚÇñü abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ()[]-–—:'’&.,!?/";
        font-size: 44px;
        font-family: "DejaVu Sans Bold";
    }
}
