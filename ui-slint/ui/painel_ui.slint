// Revive: painel inicial (Slint + Material 3). Paisagem 1280x720, renderizador por software.
// Barra de status, clima (com previsão), tocando agora, cripto e Telegram; modo noite com relógio.
// Tudo com x/y explícitos (sem layouts). Fontes só 24/26/34/84/120px.
// Os textos dinâmicos usam os caracteres do Text "fontes" no fim do componente (embutidos na fonte).

import { IconButton } from "@material";
import { Tema } from "tema.slint";

export struct HoraClima { hora: string, temp: string, icone: image }
export struct MoedaMini { simbolo: string, preco: string, variacao: string, subiu: bool }

export component PainelMat inherits Rectangle {
    in property <string> hora;
    in property <string> data;
    in property <string> cidade;
    in property <string> clima-temp;
    in property <string> clima-desc;
    in property <string> clima-maxmin;
    in property <image> clima-icone;
    in property <string> clima-erro;
    in property <[HoraClima]> proximas;

    in property <bool> wifi-ok;
    in property <string> wifi-ssid;
    in property <int> bt-qtd;
    in property <bool> na-tomada;
    in property <bool> carregando;
    in property <string> temp-cpu;

    in property <string> tocando-titulo;
    in property <string> tocando-artista;
    in property <image> tocando-capa;
    in property <bool> tocando-ativo;
    in property <bool> tocando-pausado;
    in property <float> tocando-progresso;
    in property <[MoedaMini]> moedas;
    in property <int> tg-nao-lidas;
    in property <bool> noite;

    callback ir(string);
    callback tocar-pausar();
    callback proxima();

    width: 1280px;
    height: 720px;
    background: Tema.fundo;

    // ------------------------------------------------------------ modo dia
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 720px;
        background: #00000000;
        visible: !root.noite;

        // barra de status (y 0, altura 60)
        IconButton {
            x: 12px;
            y: 8px;
            icon: @image-url("icones/arrow_back.svg");
            clicked => { root.ir("inicio"); }
        }

        // wifi + ssid
        Rectangle {
            x: 690px;
            y: 8px;
            width: 250px;
            height: 44px;
            background: #00000000;
            Image {
                x: 0px;
                y: 6px;
                width: 32px;
                height: 32px;
                source: root.wifi-ok ? @image-url("icones/wifi.svg") : @image-url("icones/wifi_off.svg");
                colorize: root.wifi-ok ? Tema.texto-sec : Tema.erro;
                image-fit: contain;
            }
            Text {
                x: 40px;
                y: 0px;
                width: 210px;
                height: 44px;
                text: root.wifi-ssid;
                font-size: 26px;
                color: root.wifi-ok ? Tema.texto-sec : Tema.erro;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.ir("wifi"); }
            }
        }

        // bluetooth + quantidade
        Rectangle {
            x: 960px;
            y: 8px;
            width: 90px;
            height: 44px;
            background: #00000000;
            Image {
                x: 0px;
                y: 6px;
                width: 32px;
                height: 32px;
                source: @image-url("icones/bluetooth.svg");
                colorize: Tema.texto-sec;
                image-fit: contain;
            }
            Text {
                x: 40px;
                y: 0px;
                width: 50px;
                height: 44px;
                text: "\{root.bt-qtd}";
                font-size: 26px;
                color: Tema.texto-sec;
                vertical-alignment: center;
            }
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.ir("bt"); }
            }
        }

        // bateria (carregando) ou tomada
        Rectangle {
            x: 1076px;
            y: 8px;
            width: 40px;
            height: 44px;
            background: #00000000;
            visible: root.carregando || root.na-tomada;
            Image {
                x: 0px;
                y: 6px;
                width: 32px;
                height: 32px;
                source: root.carregando ? @image-url("icones/battery_charging_full.svg") : @image-url("icones/power.svg");
                colorize: root.carregando ? Tema.sucesso : Tema.texto-sec;
                image-fit: contain;
            }
        }

        // temperatura da CPU
        Rectangle {
            x: 1130px;
            y: 8px;
            width: 130px;
            height: 44px;
            background: #00000000;
            Image {
                x: 0px;
                y: 6px;
                width: 32px;
                height: 32px;
                source: @image-url("icones/thermostat.svg");
                colorize: Tema.texto-sec;
                image-fit: contain;
            }
            Text {
                x: 40px;
                y: 0px;
                width: 90px;
                height: 44px;
                text: root.temp-cpu;
                font-size: 26px;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }
        }

        // ---------------------------------------------- coluna esquerda (x 30..630)
        Text {
            x: 30px;
            y: 70px;
            width: 600px;
            height: 130px;
            text: root.hora;
            font-size: 120px;
            font-family: "DejaVu Sans Bold";
            color: Tema.texto;
            horizontal-alignment: left;
            vertical-alignment: center;
        }

        Text {
            x: 30px;
            y: 200px;
            width: 600px;
            height: 44px;
            text: root.data;
            font-size: 34px;
            color: Tema.texto-sec;
            overflow: elide;
            wrap: no-wrap;
        }

        // cartão do clima
        Rectangle {
            x: 30px;
            y: 262px;
            width: 600px;
            height: 400px;
            border-radius: Tema.raio-g;
            background: Tema.superficie;
            clip: true;

            // erro: só o texto
            Text {
                x: 30px;
                y: 30px;
                width: 540px;
                height: 340px;
                text: root.clima-erro;
                font-size: 26px;
                color: Tema.texto-sec;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: root.clima-erro != "";
            }

            // conteúdo normal
            Image {
                x: 30px;
                y: 24px;
                width: 96px;
                height: 96px;
                source: root.clima-icone;
                colorize: Tema.destaque;
                image-fit: contain;
                visible: root.clima-erro == "";
            }
            Text {
                x: 150px;
                y: 16px;
                width: 420px;
                height: 100px;
                text: root.clima-temp;
                font-size: 84px;
                font-family: "DejaVu Sans Bold";
                color: Tema.texto;
                horizontal-alignment: left;
                vertical-alignment: center;
                visible: root.clima-erro == "";
            }
            Text {
                x: 30px;
                y: 128px;
                width: 540px;
                height: 36px;
                text: root.clima-desc;
                font-size: 26px;
                color: Tema.texto;
                overflow: elide;
                wrap: no-wrap;
                visible: root.clima-erro == "";
            }
            Text {
                x: 30px;
                y: 166px;
                width: 540px;
                height: 36px;
                text: root.clima-maxmin;
                font-size: 26px;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                visible: root.clima-erro == "";
            }
            Text {
                x: 30px;
                y: 204px;
                width: 540px;
                height: 32px;
                text: root.cidade;
                font-size: 24px;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                visible: root.clima-erro == "";
            }

            // previsão: 5 horas
            for h[i] in root.proximas : Rectangle {
                x: 30px + i * 108px;
                y: 250px;
                width: 108px;
                height: 124px;
                background: #00000000;
                visible: root.clima-erro == "";
                Text {
                    x: 0px;
                    y: 0px;
                    width: 108px;
                    height: 32px;
                    text: h.hora;
                    font-size: 24px;
                    color: Tema.texto-sec;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Image {
                    x: 30px;
                    y: 38px;
                    width: 48px;
                    height: 48px;
                    source: h.icone;
                    colorize: Tema.destaque;
                    image-fit: contain;
                }
                Text {
                    x: 0px;
                    y: 92px;
                    width: 108px;
                    height: 32px;
                    text: h.temp;
                    font-size: 26px;
                    color: Tema.texto;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ---------------------------------------------- coluna direita (x 660..1250)
        // cartão Tocando
        Rectangle {
            x: 660px;
            y: 76px;
            width: 590px;
            height: 240px;
            border-radius: Tema.raio-g;
            background: Tema.superficie;
            clip: true;

            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.ir(root.tocando-ativo ? "tocando" : "musica"); }
            }

            // ativo: capa + título + artista + controles + progresso
            Rectangle {
                x: 20px;
                y: 20px;
                width: 160px;
                height: 160px;
                border-radius: Tema.raio-m;
                clip: true;
                background: Tema.superficie-alta;
                visible: root.tocando-ativo;
                Image {
                    x: 0px;
                    y: 0px;
                    width: 160px;
                    height: 160px;
                    source: root.tocando-capa;
                    image-fit: cover;
                }
            }
            Text {
                x: 200px;
                y: 20px;
                width: 370px;
                height: 50px;
                text: root.tocando-titulo;
                font-size: 34px;
                font-family: "DejaVu Sans Bold";
                color: Tema.texto;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
                visible: root.tocando-ativo;
            }
            Text {
                x: 200px;
                y: 74px;
                width: 370px;
                height: 40px;
                text: root.tocando-artista;
                font-size: 26px;
                color: Tema.texto-sec;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
                visible: root.tocando-ativo;
            }
            IconButton {
                x: 196px;
                y: 130px;
                icon: root.tocando-pausado ? @image-url("icones/play_arrow.svg") : @image-url("icones/pause.svg");
                clicked => { root.tocar-pausar(); }
                visible: root.tocando-ativo;
            }
            IconButton {
                x: 286px;
                y: 130px;
                icon: @image-url("icones/skip_next.svg");
                clicked => { root.proxima(); }
                visible: root.tocando-ativo;
            }
            // barra de progresso fina
            Rectangle {
                x: 200px;
                y: 206px;
                width: 370px;
                height: 6px;
                border-radius: 3px;
                background: Tema.superficie-alta;
                visible: root.tocando-ativo;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * max(0, min(1, root.tocando-progresso));
                    height: 6px;
                    border-radius: 3px;
                    background: Tema.destaque;
                }
            }

            // inativo: ícone + convite
            Image {
                x: 52px;
                y: 52px;
                width: 96px;
                height: 96px;
                source: @image-url("icones/music_note.svg");
                colorize: Tema.texto-sec;
                image-fit: contain;
                visible: !root.tocando-ativo;
            }
            Text {
                x: 200px;
                y: 40px;
                width: 370px;
                height: 160px;
                text: @tr("Nada tocando · toque para abrir a Música");
                font-size: 26px;
                color: Tema.texto-sec;
                wrap: word-wrap;
                vertical-alignment: center;
                visible: !root.tocando-ativo;
            }
        }

        // cartão Cripto
        Rectangle {
            x: 660px;
            y: 336px;
            width: 590px;
            height: 220px;
            border-radius: Tema.raio-g;
            background: Tema.superficie;
            clip: true;

            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.ir("cripto"); }
            }
            Text {
                x: 24px;
                y: 20px;
                width: 540px;
                height: 40px;
                text: @tr("Cripto");
                font-size: 26px;
                font-family: "DejaVu Sans Bold";
                color: Tema.texto-sec;
                vertical-alignment: center;
            }
            for m[i] in root.moedas : Rectangle {
                x: 24px + i * 136px;
                y: 74px;
                width: 130px;
                height: 130px;
                background: #00000000;
                Text {
                    x: 0px;
                    y: 0px;
                    width: 130px;
                    height: 36px;
                    text: m.simbolo;
                    font-size: 26px;
                    font-family: "DejaVu Sans Bold";
                    color: Tema.texto;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
                Text {
                    x: 0px;
                    y: 38px;
                    width: 130px;
                    height: 48px;
                    text: m.preco;
                    font-size: 34px;
                    color: Tema.texto;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
                Text {
                    x: 0px;
                    y: 92px;
                    width: 130px;
                    height: 32px;
                    text: m.variacao;
                    font-size: 24px;
                    color: m.subiu ? Tema.sucesso : Tema.erro;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
            }
        }

        // cartão Telegram (só com mensagens não lidas)
        Rectangle {
            x: 660px;
            y: 576px;
            width: 590px;
            height: 96px;
            border-radius: Tema.raio-g;
            background: Tema.superficie;
            clip: true;
            visible: root.tg-nao-lidas > 0;

            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.ir("telegram"); }
            }
            Image {
                x: 30px;
                y: 28px;
                width: 40px;
                height: 40px;
                source: @image-url("icones/chat.svg");
                colorize: Tema.destaque;
                image-fit: contain;
            }
            Text {
                x: 96px;
                y: 28px;
                width: 470px;
                height: 40px;
                text: @tr("{n} mensagem não lida" | "{n} mensagens não lidas" % root.tg-nao-lidas);
                font-size: 26px;
                color: Tema.texto;
                overflow: elide;
                wrap: no-wrap;
                vertical-alignment: center;
            }
        }
    }

    // ------------------------------------------------------------ modo noite
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 720px;
        background: #000000;
        visible: root.noite;

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.ir("acordar"); }
        }
        Text {
            x: 0px;
            y: 280px;
            width: 1280px;
            height: 160px;
            text: root.hora;
            font-size: 120px;
            color: Tema.texto-sec;
            opacity: 0.5;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ------------------------------------------------------------ fontes
    // Caracteres embutidos: a fonte só leva os glifos que aparecem em textos literais.
    // Estes Texts invisíveis cobrem os textos dinâmicos, em cada tamanho e família usados.
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 120px; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 120px; font-family: "DejaVu Sans Bold"; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 84px; font-family: "DejaVu Sans Bold"; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 34px; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 34px; font-family: "DejaVu Sans Bold"; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 26px; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 26px; font-family: "DejaVu Sans Bold"; }
    Text { visible: false; text: "0123456789°/·:%+-−,.R$US$ abcdefghijklmnopqrstuvwxyzáàâãéêíóôõúçABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÚÇ"; font-size: 24px; }
}
