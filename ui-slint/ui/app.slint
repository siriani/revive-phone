// ícones do clima por nome (o Rust escolhe o nome; as imagens vêm embutidas)
export global IconesClima {
    public pure function img(n: string) -> image {
        if n == "sunny" { return @image-url("icones/sunny.svg"); }
        if n == "clear_night" { return @image-url("icones/clear_night.svg"); }
        if n == "partly_cloudy_day" { return @image-url("icones/partly_cloudy_day.svg"); }
        if n == "partly_cloudy_night" { return @image-url("icones/partly_cloudy_night.svg"); }
        if n == "foggy" { return @image-url("icones/foggy.svg"); }
        if n == "rainy" { return @image-url("icones/rainy.svg"); }
        if n == "weather_snowy" { return @image-url("icones/weather_snowy.svg"); }
        if n == "thunderstorm" { return @image-url("icones/thunderstorm.svg"); }
        return @image-url("icones/cloud.svg");
    }
}
